<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MandoCode.Desktop.ChatTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MandoCode.Desktop">

    <Grid x:Name="ChatRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======= Per-tab header =======
             Connection, model, tokens, project folder, and the folder action all
             describe THIS agent. Each tab has its own, because each tab has its own
             AIService, TokenTrackingService, and ProjectRootAccessor. -->
        <Grid Grid.Row="0" Padding="16,8,16,8" Background="{StaticResource MandoPanelBrush}"
              ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center"/>

                <!-- Clicking the model opens a quick-switch dropdown anchored to the button.
                     It's a tab-local switch — it never touches the saved default. (The typed
                     /model command still uses the overlay wizard.) -->
                <Button x:Name="ModelButton" Padding="6,3"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Switch the model for this tab only (doesn't change the saved default)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ModelText" Text="" VerticalAlignment="Center"
                                   Foreground="{StaticResource MandoSkyBrush}" FontSize="13"/>
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ModelFlyout" Placement="Bottom" Opening="ModelFlyout_Opening">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinWidth" Value="260"/>
                                    <Setter Property="MaxWidth" Value="380"/>
                                    <Setter Property="MaxHeight" Value="400"/>
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid MinWidth="260">
                                <!-- Loading state: shown immediately while models are fetched. -->
                                <StackPanel x:Name="ModelLoadingPanel" Orientation="Horizontal" Spacing="10"
                                            Padding="16,16" VerticalAlignment="Center">
                                    <ProgressRing IsActive="True" Width="18" Height="18"/>
                                    <TextBlock Text="Loading models…" VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                                <!-- Error state (unreachable Ollama, empty list, …). -->
                                <TextBlock x:Name="ModelErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                                           Padding="16,14" Opacity="0.85" MaxWidth="340"/>
                                <!-- Loaded list — cloud first, badge per row; click to switch. -->
                                <ListView x:Name="ModelList" Visibility="Collapsed"
                                          SelectionMode="Single" IsItemClickEnabled="True"
                                          ItemClick="ModelList_ItemClick" Padding="4,6">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="10,7"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ModelItem">
                                            <Grid ColumnSpacing="12" MinWidth="220">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" FontSize="13"/>
                                                <Border Grid.Column="1" CornerRadius="6" Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind BadgeBackground}">
                                                    <TextBlock Text="{x:Bind Badge}" FontSize="11"
                                                               Foreground="{x:Bind BadgeForeground}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <TextBlock x:Name="TokenText" Text="" VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
            </StackPanel>

            <TextBlock x:Name="ProjectRootText" Grid.Column="1" Text="" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Opacity="0.6" FontSize="12"
                       TextTrimming="CharacterEllipsis" Margin="16,0,8,0"
                       ToolTipService.ToolTip="This tab's project folder"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Padding="8,5"
                        ToolTipService.ToolTip="Change this tab's project folder">
                    <FontIcon Glyph="&#xE8B7;" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>

        <WebView2 x:Name="TranscriptView" Grid.Row="1" DefaultBackgroundColor="#16121F"/>

        <StackPanel x:Name="PlanProgressPanel" Grid.Row="2" Visibility="Collapsed" Padding="16,6,16,0">
            <TextBlock x:Name="PlanProgressText" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
            <ProgressBar x:Name="PlanProgressBar" Minimum="0" Maximum="100" Height="4"
                         Foreground="{StaticResource MandoAccentBrush}"/>
        </StackPanel>

        <StackPanel x:Name="BusyPanel" Grid.Row="3" Orientation="Horizontal" Spacing="10"
                    Padding="16,8,16,0" Visibility="Collapsed">
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18"
                          Foreground="{StaticResource MandoAccentBrush}"/>
            <TextBlock x:Name="BusyText" Text="Thinking..." VerticalAlignment="Center"
                       Opacity="0.75" FontSize="13"/>
            <TextBlock Text="(Esc to cancel)" VerticalAlignment="Center" Opacity="0.4" FontSize="12"/>
        </StackPanel>

        <!-- ======= Create-snapshot offer (opt-in) =======
             Appears when a model switch (or "Take snapshot") buffers a conversation. Snapshots are
             born summarized: pick the model to summarize with — the origin model by default, or any
             installed model (local = free, cloud = may spend tokens). Ignore it and the conversation
             is discarded (pure opt-in, no auto-save). -->
        <Border x:Name="SnapshotOfferCard" Grid.Row="4" Visibility="Collapsed"
                Margin="16,8,16,0" Padding="14,12" CornerRadius="10"
                Background="{StaticResource MandoPanelBrush}"
                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid>
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="14" VerticalAlignment="Center"
                                      Foreground="{StaticResource MandoAccentBrush}"/>
                            <TextBlock Text="Create a context snapshot?" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <TextBlock x:Name="SnapshotOfferSubtitle" Opacity="0.6" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Click="SnapshotOfferDismiss_Click" Padding="6" Background="Transparent"
                            BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                            ToolTipService.ToolTip="Dismiss — the conversation won't be saved">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>
                <!-- Name (optional) and the summarizer model share one row: [name] [model] [Create]. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SnapshotNameBox" Grid.Column="0" PlaceholderText="Name (optional)"
                             MaxLength="80" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SnapshotModelCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Model that will write the recap">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ModelChoice">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="5" Padding="6,1" VerticalAlignment="Center"
                                            Background="{StaticResource MandoBackgroundBrush}">
                                        <TextBlock Text="{x:Bind Tag}" FontSize="10" Opacity="0.75"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="SnapshotCreateButton" Grid.Column="2" Content="Create"
                            Click="SnapshotCreate_Click" VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Padding="16,10,16,14" ColumnSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SuggestionsPanel" Grid.Row="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="{StaticResource MandoPanelBrush}"
                    BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Margin="0,0,0,8" MaxHeight="220">
                <ListView x:Name="SuggestionsList" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="SuggestionsList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CommandSuggestion">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,2">
                                <TextBlock Text="{x:Bind Command}" FontFamily="Cascadia Code,Consolas"
                                           Foreground="{StaticResource MandoSkyBrush}" MinWidth="140"/>
                                <TextBlock Text="{x:Bind Description}" Opacity="0.6" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <TextBox x:Name="InputBox" Grid.Row="1" Grid.Column="0"
                     PlaceholderText="Ask MandoCode anything… (/ for commands, @file to attach, !cmd for shell)"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                     PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"/>

            <Button x:Name="SendButton" Grid.Row="1" Grid.Column="1" Click="SendButton_Click"
                    VerticalAlignment="Stretch" MinWidth="88"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="14"/>
                    <TextBlock x:Name="SendLabel" Text="Send"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ======= Approval overlay — this tab only.
             Each tab owns its WinUiApprovalService, ApprovalPromptGate and McpApprovalGate,
             so two agents can sit at an approval prompt simultaneously without one blocking
             the other's overlay from ever rendering. ======= -->
        <Grid x:Name="ApprovalOverlay" Grid.RowSpan="5" Visibility="Collapsed"
              Background="#B0000000">
            <Border x:Name="ApprovalCard" MaxWidth="860" MaxHeight="640" Margin="24" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource MandoPanelBrush}"
                    BorderBrush="{StaticResource MandoAccentBrush}" BorderThickness="1"
                    CornerRadius="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ApprovalTitle" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource MandoSkyBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ApprovalSubtitle" Grid.Row="1" FontSize="13"
                               FontFamily="Cascadia Code,Consolas" Opacity="0.8"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="ApprovalDetail" Grid.Row="2" FontSize="13" Opacity="0.7"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                    <ScrollViewer x:Name="ApprovalBodyScroll" Grid.Row="3" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource MandoBackgroundBrush}" CornerRadius="8"
                                  Padding="10" MaxHeight="320">
                        <ItemsControl x:Name="ApprovalDiffList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:DiffLineVm">
                                    <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Brush}"
                                               FontFamily="Cascadia Code,Cascadia Mono,Consolas"
                                               FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Spacing="8">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ApprovalButtons" Spacing="6"/>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Instruction input spans the body + footer rows so the text box
                         fills the enlarged card instead of hugging the bottom edge. -->
                    <Grid x:Name="InstructionPanel" Grid.Row="3" Grid.RowSpan="2"
                          Visibility="Collapsed" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="InstructionPrompt" FontSize="13" Opacity="0.8"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Name="InstructionBox" Grid.Row="1" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="InstructionBox_KeyDown"
                                 PlaceholderText="Type your answer — Enter to submit, Shift+Enter for a new line"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                            <Button Content="Submit" Click="InstructionSubmit_Click"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <Button x:Name="InstructionCancelButton" Content="Cancel"
                                    Click="InstructionCancel_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
