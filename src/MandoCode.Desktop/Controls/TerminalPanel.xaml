<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MandoCode.Desktop.Controls.TerminalPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MandoCode.Desktop.Controls">

    <!-- Background matches the xterm surface (#0B0B12) so the WebView2's slightly-late resize
         repaint doesn't flash a different color through the gap while the splitter is dragged. -->
    <Grid Background="#0B0B12"
          BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="0,1,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======= Terminal tab strip / toolbar ======= -->
        <Grid Grid.Row="0" Background="{StaticResource MandoPanelBrush}" Padding="6,3"
              BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE756;" FontSize="13" Margin="6,0,10,0"
                      VerticalAlignment="Center" Foreground="{StaticResource MandoAccentBrush}"/>

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="4"/>
                    <!-- Primary click opens the default shell; the chevron picks a specific one. -->
                    <SplitButton x:Name="NewTerminalButton" Click="NewTerminal_Click" Padding="7,3"
                                 Background="Transparent" BorderThickness="0"
                                 ToolTipService.ToolTip="New terminal (Ctrl+Shift+`)">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="ShellMenu" Placement="Bottom"/>
                        </SplitButton.Flyout>
                    </SplitButton>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="ClearButton" Click="Clear_Click" Padding="7,4"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Clear active terminal">
                    <FontIcon Glyph="&#xE894;" FontSize="12"/>
                </Button>
                <Button x:Name="MaximizeButton" Click="Maximize_Click" Padding="7,4"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Maximize terminal">
                    <FontIcon x:Name="MaximizeIcon" Glyph="&#xE740;" FontSize="12"/>
                </Button>
                <Button x:Name="HidePanelButton" Click="HidePanel_Click" Padding="7,4"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Hide terminal (Ctrl+`)">
                    <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======= xterm.js host (multiplexes every shell tab) ======= -->
        <WebView2 x:Name="TermView" Grid.Row="1" DefaultBackgroundColor="#0B0B12"/>
    </Grid>
</UserControl>
