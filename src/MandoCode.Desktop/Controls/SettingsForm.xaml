<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MandoCode.Desktop.Controls.SettingsForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MandoCode.Desktop.Controls"
    xmlns:services="using:MandoCode.Desktop.Services">

    <UserControl.Resources>
        <!-- How wide the form's CONTENT may get. Deliberately on the content and not on the control:
             the ScrollViewer below has to span the host's full width so its scrollbar sits on the
             window edge where it belongs. Capping the whole control instead (as the Settings page
             first did) drags the scrollbar inward to the content's edge, leaving it stranded in the
             middle of the page. Inert in the agent pane, which is narrower than this anyway. -->
        <x:Double x:Key="FormContentWidth">680</x:Double>

        <!-- Help text under a field. Visible rather than tooltip-only: these settings change how the
             agent behaves in ways you cannot infer from the label, and a number you do not understand
             is a number you will not touch. Where a field carries one of these, its tooltip is
             removed rather than duplicated.
             Opacity 0.6 rather than the 0.5 used elsewhere — six of these at once is a lot of low
             contrast text, and this still reads clearly as secondary. -->
        <Style x:Key="FieldDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <!-- Negative top margin pulls the note up against the field it describes, out of the
                 parent StackPanel's 14px rhythm. -->
            <Setter Property="Margin" Value="0,-6,0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- ======= The settings form, hosted twice =======
         Once on the rail's Settings page, bound to the global defaults; once in the pane behind an
         agent's gear icon, bound to that agent. The two differ ONLY in what ISettingsScope writes
         to, so this is a single control rather than two copies of ~250 lines of markup that would
         drift apart the first time a config key is added.

         Nothing here sets a fixed width: the two hosts are very different shapes (a full-width page
         and a ~380px docked pane), so everything stretches and the PAGE constrains itself with
         MaxWidth instead. -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ScopeText" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                   MaxWidth="{StaticResource FormContentWidth}" HorizontalAlignment="Left"/>

        <SelectorBar Grid.Row="1" x:Name="SettingsTabs" HorizontalAlignment="Left"
                     SelectionChanged="SettingsTabs_SelectionChanged">
            <SelectorBarItem x:Name="Tab_Model" Text="Model"/>
            <SelectorBarItem x:Name="Tab_Behavior" Text="Behavior"/>
            <SelectorBarItem x:Name="Tab_Integrations" Text="Integrations"/>
        </SelectorBar>

        <ScrollViewer Grid.Row="2">
            <Grid>
                <StackPanel x:Name="TabPanel_Model" Visibility="Collapsed" Spacing="14"
                            MaxWidth="{StaticResource FormContentWidth}"
                            HorizontalAlignment="Left" Padding="0,4,0,8">
                    <!-- ======= Connection — defaults scope only =======
                         An agent gets its endpoint when it launches, and its model from the
                         dropdown in its own header. Repeating either here would be a second place
                         to change the same thing, and the pane's copy would go stale the moment the
                         header's dropdown was used. The scope's KeysOwnedElsewhere says the same
                         thing to the save path. -->
                    <StackPanel x:Name="ConnectionSection" Spacing="14">
                        <TextBlock Text="Connection" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource MandoAccentBrush}"/>
                        <!-- Defaults scope only. The wizard runs in a chat transcript, but what it
                             CONFIGURES is the app: it finishes with SaveDefaultsFrom, so its result is
                             the defaults, not the settings of whichever agent it happened to run in. -->
                        <StackPanel x:Name="SetupWizardRow" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SetupWizardButton" Click="RunSetupWizard_Click"
                                    ToolTipService.ToolTip="Guided setup: reach Ollama, install or start it if needed, and pick a model — the same wizard that runs on first launch. Runs in the open agent's chat, and saves what you pick as the defaults here.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE945;" FontSize="13"/>
                                    <TextBlock Text="Run guided setup"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="SetupWizardHint"
                                       Text="walks through connection + model, then saves them as the defaults"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Ollama endpoint" FontSize="13" Opacity="0.8"/>
                        <TextBox x:Name="EndpointBox" PlaceholderText="http://localhost:11434"
                                 HorizontalAlignment="Stretch" TextChanged="Endpoint_Changed"
                                 ToolTipService.ToolTip="Where the Ollama server listens. Every model request goes here — point it at another machine or port to run the model remotely."/>
                        <TextBlock Text="Model" FontSize="13" Opacity="0.8"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModelCombo" IsEditable="True" HorizontalAlignment="Stretch"
                                      PlaceholderText="e.g. qwen2.5-coder:14b"
                                      SelectionChanged="ModelCombo_Changed" TextSubmitted="ModelCombo_Changed"
                                      ToolTipService.ToolTip="The model that powers every response. Bigger models reason better but respond slower and need more memory; coder-tuned models follow tool-calling instructions most reliably.">
                                <ComboBox.Resources>
                                    <services:PinnedOpacityConverter x:Key="PinnedOpacity"/>
                                </ComboBox.Resources>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Tag="{Binding}" Tapped="ModelPin_Tapped"
                                                    Background="Transparent" BorderThickness="0" Padding="4"
                                                    ToolTipService.ToolTip="Pin this model to the top of the list"
                                                    AutomationProperties.Name="Pin model to top">
                                                <FontIcon Glyph="&#xE718;" FontSize="12"
                                                          Opacity="{Binding Converter={StaticResource PinnedOpacity}}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Click="RefreshModels_Click"
                                    ToolTipService.ToolTip="Fetch pulled models">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ModelListStatus" Text="" FontSize="12" Opacity="0.7"
                                   TextWrapping="Wrap"/>

                        <Border Height="1" Background="{StaticResource MandoBorderBrush}" Margin="0,4"/>
                    </StackPanel>

                    <TextBlock Text="Generation" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource MandoAccentBrush}"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="S_Temperature" Header="Temperature" Minimum="0" Maximum="1"
                                StepFrequency="0.05" ValueChanged="Temperature_Changed"/>
                        <TextBlock x:Name="S_TemperatureLabel" Grid.Column="1" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8" Opacity="0.7" FontSize="13" MinWidth="36"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldDescription}"
                               Text="How much the model varies its wording. Low keeps answers precise and repeatable, which is what you want for code; high makes it more inventive but less reliable at calling tools. 0.2–0.4 suits coding."/>

                    <NumberBox x:Name="S_MaxTokens" Header="Max response tokens" Tag="maxTokens"
                               Minimum="1" SpinButtonPlacementMode="Compact" SmallChange="1024"
                               ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"/>
                    <TextBlock Style="{StaticResource FieldDescription}"
                               Text="The longest a single reply may be. Raise it if answers get cut off part-way through code; lower it for shorter, faster replies."/>
                    <NumberBox x:Name="S_ContextLength" Header="Context window (tokens, 0 = Ollama default)"
                               Tag="contextLength" Minimum="0" SpinButtonPlacementMode="Compact" SmallChange="2048"
                               ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                               ToolTipService.ToolTip="How much conversation and file content the model can see at once. Larger windows track big files and long chats but use much more RAM/VRAM and respond slower. 0 keeps the Ollama default."/>
                    <TextBlock x:Name="ContextLengthNote" Style="{StaticResource FieldDescription}"/>
                    <ComboBox x:Name="S_Streaming" Header="Response streaming" SelectionChanged="Streaming_Changed"
                              HorizontalAlignment="Stretch"
                              ToolTipService.ToolTip="Which models use the streaming transport under the hood. Streamed chunks feed the stall watchdog, so long generations are not mistaken for a stalled model. Text still appears per completed turn either way — all is the most reliable choice.">
                        <x:String>all</x:String>
                        <x:String>cloud</x:String>
                        <x:String>off</x:String>
                    </ComboBox>
                </StackPanel>

                <StackPanel x:Name="TabPanel_Behavior" Visibility="Collapsed" Spacing="14"
                            MaxWidth="{StaticResource FormContentWidth}"
                            HorizontalAlignment="Left" Padding="0,4,0,8">
                    <TextBlock Text="Behavior" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource MandoAccentBrush}"/>
                    <!-- App-wide (naming happens in SessionManager before any agent exists), which is
                         why it shows on the defaults page only — on an agent's own pane it would read
                         as a per-agent setting it is not. Applies to agents opened after the change. -->
                    <ToggleSwitch x:Name="S_AgentCallsigns" Header="Callsign names for new agents"
                                  Toggled="AgentCallsigns_Toggled"
                                  ToolTipService.ToolTip="On (default): each new agent draws a random callsign — Morphy, Kernel, Cloud — from a 500-name deck that does not repeat until it runs dry. Off: new agents are Agent 1, Agent 2, … Renaming a tab always works either way."/>
                    <ToggleSwitch x:Name="S_TaskPlanning" Header="Task planning (propose_plan for multi-step requests)"
                                  Tag="taskPlanning" Toggled="Setting_Toggled"
                                  ToolTipService.ToolTip="For multi-step requests the model first proposes a numbered plan you approve before any work starts. More predictable on big tasks; an extra step on small ones."/>
                    <ToggleSwitch x:Name="S_DiffApprovals" Header="Diff approvals (review writes, deletes, and commands)"
                                  Tag="diffApprovals" Toggled="Setting_Toggled"
                                  ToolTipService.ToolTip="The AI must show you a diff and get your approval before writing files, deleting, or running commands. Off = changes apply instantly with no review — only for full trust."/>
                    <ToggleSwitch x:Name="S_AutoContinue" Header="Auto-continue past tool budget limits"
                                  Tag="autoContinue" Toggled="Setting_Toggled"
                                  ToolTipService.ToolTip="When a request exhausts its tool budget mid-task, MandoCode automatically tells the model to keep going instead of stopping to ask you."/>
                    <NumberBox x:Name="S_MaxContinuations" Header="Max auto-continuations per request" Tag="maxContinuations"
                               Minimum="0" SpinButtonPlacementMode="Compact" SmallChange="1"
                               ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                               ToolTipService.ToolTip="Safety cap on auto-continue — stops a model that never finishes from looping forever."/>

                    <Border Height="1" Background="{StaticResource MandoBorderBrush}" Margin="0,4"/>
                    <TextBlock Text="Limits" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource MandoAccentBrush}"/>
                    <NumberBox x:Name="S_RequestTimeout" Header="Per-request timeout (minutes)" Tag="timeout"
                               Minimum="1" SpinButtonPlacementMode="Compact" SmallChange="1"
                               ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"/>
                    <TextBlock Style="{StaticResource FieldDescription}"
                               Text="The ceiling for one whole request — every model call and tool run it makes, added together. Raise it for large tasks on slow hardware; lower it to give up sooner when something is wrong."/>
                    <NumberBox x:Name="S_StallTimeout" Header="Stall watchdog per model call (seconds)" Tag="modelResponseTimeout"
                               Minimum="5" SpinButtonPlacementMode="Compact" SmallChange="30"
                               ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"/>
                    <TextBlock Style="{StaticResource FieldDescription}"
                               Text="How long one model call may stay silent before it is treated as stalled and cancelled. Raise it if a large model on slow hardware keeps getting killed while it is still thinking."/>
                    <NumberBox x:Name="S_ToolBudget" Header="Tool-result character budget per request" Tag="toolBudget"
                               Minimum="1000" SpinButtonPlacementMode="Compact" SmallChange="50000"
                               ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"/>
                    <TextBlock Style="{StaticResource FieldDescription}"
                               Text="How much tool output — file reads, command results — is fed back to the model in one request. Higher lets it see more of your project, but slows replies and can overflow a small context window."/>
                    <NumberBox x:Name="S_RenderTimeout" Header="Markdown render timeout (seconds)" Tag="renderTimeout"
                               Minimum="1" SpinButtonPlacementMode="Compact" SmallChange="10"
                               ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"/>
                    <TextBlock Style="{StaticResource FieldDescription}"
                               Text="How long to spend formatting a reply before falling back to plain text. Cosmetic only — it never changes what the model actually said."/>
                </StackPanel>

                <StackPanel x:Name="TabPanel_Integrations" Visibility="Collapsed" Spacing="14"
                            MaxWidth="{StaticResource FormContentWidth}"
                            HorizontalAlignment="Left" Padding="0,4,0,8">
                    <ToggleSwitch x:Name="S_WebSearch" Header="Web search" Tag="webSearch" Toggled="Setting_Toggled"
                                  ToolTipService.ToolTip="Gives the model a web-search tool for current information. Off = it only knows its training data and your project files."/>
                    <!-- App-wide, like callsigns, and for a sharper reason: the key is a secret, and
                         per-agent settings are persisted per agent — a key that rode along would be
                         one copy on disk per configured agent. AgentConfigStore strips it, so it
                         lives in the shared config only and appears on the defaults page only. -->
                    <StackPanel x:Name="TavilySection" Spacing="14">
                        <TextBlock Text="Tavily API key — shared by every agent (optional; more reliable web search, free at app.tavily.com)"
                                   FontSize="13" Opacity="0.8" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="S_TavilyKey" PlaceholderText="tvly-…" HorizontalAlignment="Stretch"
                                         PasswordRevealMode="Hidden" PasswordChanged="TavilyKey_Changed"
                                         ToolTipService.ToolTip="With a key, web searches use the Tavily structured results instead of the built-in scraper — cleaner sources for the model, so better-grounded answers. Shared by every agent."/>
                            <Button Grid.Column="1" x:Name="TavilyViewButton" Content="View" IsEnabled="False"
                                    Click="TavilyView_Click"
                                    ToolTipService.ToolTip="Show or hide the key"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="TavilyElsewhereNote" Visibility="Collapsed"
                               Text="The Tavily API key is shared by every agent — set it on the rail's Settings page."
                               Opacity="0.5" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="MCP servers are managed on the MCP page (rail), where each agent also opts in to using their tools."
                               Opacity="0.5" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ======= Actions =======
             Ordered by importance, not by kind. Save is the primary action of the whole form —
             nothing here applies until it is pressed — so it gets its own full-width row at the
             top; the two transfer actions are a separate, quieter block below a divider. They were
             side by side, which made the widest SECONDARY button the first thing the eye landed on.

             The pending count lives INSIDE the button rather than as a caption under it: it is a
             property of the save, and as a caption it left the column ragged. -->
        <!-- Width is set in code (ApplyContentWidth), not here. "Left-aligned at min(available, cap)"
             has no declarative form: Stretch + MaxWidth centres the panel, and HorizontalAlignment
             Left makes a StackPanel shrink-wrap to its widest button — which quietly un-did Save
             being the full-width primary. -->
        <StackPanel x:Name="ActionPanel" Grid.Row="3" Spacing="8" Margin="0,4,0,0"
                    HorizontalAlignment="Left">
            <TextBlock x:Name="SettingsStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                       Foreground="{StaticResource MandoGoldBrush}"/>

            <Button x:Name="SaveButton" Click="Save_Click" IsEnabled="False"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,7"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Apply the changes you have made here. Nothing on this page takes effect until you save, and closing it discards anything unsaved.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                    <TextBlock Text="Save"/>
                    <TextBlock x:Name="UnsavedText" Text="" Opacity="0.8"/>
                </StackPanel>
            </Button>

            <Border Height="1" Background="{StaticResource MandoBorderBrush}" Margin="0,4"/>

            <!-- Agent scope only: pulls the defaults DOWN onto this agent (and drops its saved file,
                 so it follows later changes to them again). Its mirror image sits below. -->
            <Button x:Name="ApplyDefaultsButton" Click="ApplyDefaults_Click" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,6"
                    ToolTipService.ToolTip="Replace this agent's settings with the current defaults for new agents, and let it follow future changes to them again. Applies straight away. Only this agent changes — other agents and the saved defaults are untouched.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE895;" FontSize="13"/>
                    <TextBlock Text="Apply Global Defaults"/>
                </StackPanel>
            </Button>

            <!-- Agent scope only: pushes this agent's settings UP to become the defaults. -->
            <Button x:Name="SaveToDefaultsButton" Click="SaveToDefaults_Click" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,6"
                    ToolTipService.ToolTip="Make this agent's settings the starting point for new agents. Anything unsaved here is saved to the agent first, so the two always agree. Agents already open keep their own — and this agent goes back to following the defaults, since it now matches them.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE898;" FontSize="13"/>
                    <TextBlock Text="Save to Global Defaults"/>
                </StackPanel>
            </Button>

            <!-- Defaults scope only: there is nothing global to pull from here, so the escape hatch
                 is the app's built-in values. -->
            <Button x:Name="ResetFactoryButton" Click="ResetFactory_Click" Visibility="Collapsed"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,6"
                    ToolTipService.ToolTip="Put the settings on the visible tab back to MandoCode's built-in values. Staged like any other change — press Save to keep it.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" FontSize="13"/>
                    <TextBlock x:Name="ResetFactoryText" Text="Reset Model to Factory"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
