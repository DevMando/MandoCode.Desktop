<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MandoCode.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MandoCode.Desktop"
    xmlns:controls="using:MandoCode.Desktop.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:services="using:MandoCode.Desktop.Services">

    <Grid x:Name="Root" KeyDown="Root_KeyDown" Background="{StaticResource MandoBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition x:Name="SnapshotsColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======= Sidebar rail =======
             Full-screen pages, not tabs. Settings acts on whichever agent tab is currently selected
             (per-agent). Snapshots, MCP servers, and Appearance are app-global — one surface for the
             whole app, regardless of which agent is active. -->
        <Grid Grid.Column="0" Background="{StaticResource MandoPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Padding="4,12" Spacing="6">
            <Button x:Name="NavChat" Click="NavChat_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="Agents — your chat tabs">
                <FontIcon x:Name="NavChatIcon" Glyph="&#xE8BD;" FontSize="16"/>
            </Button>
            <!-- Global (not per-agent): the snapshot store is app-wide, so one manager lists every
                 tab's snapshots. Toggles the wide panel to the right of the rail. -->
            <Button x:Name="NavSnapshots" Click="NavSnapshots_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="Context snapshots — save &amp; reuse a conversation">
                <Grid>
                    <FontIcon x:Name="NavSnapshotsIcon" Glyph="&#xE722;" FontSize="16"/>
                    <Border x:Name="NavSnapshotsBadge" Visibility="Collapsed"
                            Background="{StaticResource MandoGoldBrush}" CornerRadius="7"
                            MinWidth="14" Height="14" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0">
                        <TextBlock x:Name="NavSnapshotsBadgeText" Text="0" FontSize="9" FontWeight="SemiBold"
                                   Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>
            <!-- Global (the archive is app-wide): reopen a conversation you closed. Shares the
                 docked panel column with Snapshots. -->
            <Button x:Name="NavHistory" Click="NavHistory_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="History — reopen a closed conversation">
                <Grid>
                    <FontIcon x:Name="NavHistoryIcon" Glyph="&#xE81C;" FontSize="16"/>
                    <Border x:Name="NavHistoryBadge" Visibility="Collapsed"
                            Background="{StaticResource MandoGoldBrush}" CornerRadius="7"
                            MinWidth="14" Height="14" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0">
                        <TextBlock x:Name="NavHistoryBadgeText" Text="0" FontSize="9" FontWeight="SemiBold"
                                   Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>
            <!-- Notes. A note belongs to the folder an agent works out of (it's a file in that
                 folder's notes/), but the panel that browses them is app-wide — same shape as
                 Snapshots and History, and the reason a note survives closing the agent that
                 created it. Shares the docked panel column with those two. -->
            <Button x:Name="NavNotes" Click="NavNotes_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="Notes — jot ideas into the project you're working in">
                <FontIcon x:Name="NavNotesIcon" Glyph="&#xE70B;" FontSize="16"/>
            </Button>
            <Button x:Name="NavSettings" Click="NavSettings_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="Settings — the selected agent's config">
                <FontIcon x:Name="NavSettingsIcon" Glyph="&#xE713;" FontSize="16"/>
            </Button>
            <!-- Divider: everything below is app-global, not per-agent. -->
            <Border Background="{StaticResource MandoBorderBrush}" Height="1"
                    HorizontalAlignment="Stretch" Margin="8,2" Opacity="0.6"/>
            <Button x:Name="NavMcp" Click="NavMcp_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="MCP servers — connect external tools">
                <FontIcon x:Name="NavMcpIcon" Glyph="&#xE71B;" FontSize="16"/>
            </Button>
            <!-- Global: the user skills directory is app-wide, so one manager serves every agent. -->
            <Button x:Name="NavSkills" Click="NavSkills_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="Skills — reusable instructions the AI loads on demand">
                <FontIcon x:Name="NavSkillsIcon" Glyph="&#xE7BE;" FontSize="16"/>
            </Button>
            <!-- Global (one audio device, one app-wide MusicPlayerService): background playlists.
                 A flyout rather than a page — music is a set-and-forget control, not a workspace.
                 While something is playing the glyph hides entirely and the gold equalizer below
                 takes its place, so the glyph itself is only ever the idle/paused state. -->
            <!-- Tooltip is set in code (UpdateMusicRailIcon) — it live-updates to the track name. -->
            <Button x:Name="NavMusic" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch">
                <Grid Width="16" Height="16">
                    <!-- Themed here rather than in RefreshNavIcons (which colors every other rail
                         icon) because music is a flyout with no active-page state to toggle: it's
                         always the idle color. ThemeManager.SetBrush mutates the shared brush's
                         Color in place, so this StaticResource retints on every theme change —
                         same mechanism the EqBar style below relies on. Without it the FontIcon
                         inherits WinUI's default foreground and stays white in all 16 themes. -->
                    <FontIcon x:Name="NavMusicIcon" Glyph="&#xE8D6;" FontSize="16"
                              Foreground="{StaticResource MandoDimBrush}"/>
                    <!-- Equalizer: three gold bars that bounce while music plays (the glyph hides).
                         Scale animations are dependent (UI-thread) by necessity; three bars on one
                         icon is negligible. Staggered durations so the bounce never looks locked. -->
                    <StackPanel x:Name="MusicEqPanel" Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <StackPanel.Resources>
                            <Storyboard x:Name="MusicEqStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="EqScale1" Storyboard.TargetProperty="ScaleY"
                                                 From="0.3" To="1.0" Duration="0:0:0.35" EnableDependentAnimation="True"/>
                                <DoubleAnimation Storyboard.TargetName="EqScale2" Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="0.35" Duration="0:0:0.45" EnableDependentAnimation="True"/>
                                <DoubleAnimation Storyboard.TargetName="EqScale3" Storyboard.TargetProperty="ScaleY"
                                                 From="0.5" To="0.9" Duration="0:0:0.28" EnableDependentAnimation="True"/>
                            </Storyboard>
                            <!-- The bars render only while the storyboard runs, so the animations'
                                 From values are the single definition of the starting pose. -->
                            <Style x:Key="EqBar" TargetType="Rectangle">
                                <Setter Property="Width" Value="3"/>
                                <Setter Property="Height" Value="14"/>
                                <Setter Property="Fill" Value="{StaticResource MandoGoldBrush}"/>
                                <Setter Property="RadiusX" Value="1.5"/>
                                <Setter Property="RadiusY" Value="1.5"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
                            </Style>
                        </StackPanel.Resources>
                        <Rectangle Style="{StaticResource EqBar}">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="EqScale1"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Style="{StaticResource EqBar}">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="EqScale2"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Style="{StaticResource EqBar}">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="EqScale3"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="MusicFlyout" Placement="Right" Opening="MusicFlyout_Opening">
                        <StackPanel Spacing="10" MinWidth="248">
                            <TextBlock Text="Music" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="MusicTrackText" Text="Nothing playing" FontSize="12"
                                       Opacity="0.75" TextTrimming="CharacterEllipsis" MaxWidth="248"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="MusicPlayPauseButton" Click="MusicPlayPause_Click" Padding="12,6"
                                        ToolTipService.ToolTip="Play / pause">
                                    <FontIcon x:Name="MusicPlayPauseIcon" Glyph="&#xE768;" FontSize="14"/>
                                </Button>
                                <Button x:Name="MusicNextButton" Click="MusicNext_Click" Padding="12,6"
                                        ToolTipService.ToolTip="Next track">
                                    <FontIcon Glyph="&#xE893;" FontSize="14"/>
                                </Button>
                                <Button x:Name="MusicStopButton" Click="MusicStop_Click" Padding="12,6"
                                        ToolTipService.ToolTip="Stop">
                                    <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE767;" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                                <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="100" Width="180"
                                        ValueChanged="MusicVolume_ValueChanged"/>
                            </StackPanel>
                            <ComboBox x:Name="MusicGenreCombo" Header="Playlist" HorizontalAlignment="Stretch"
                                      SelectionChanged="MusicGenre_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Click="MusicAddPlaylist_Click" Padding="10,5"
                                        ToolTipService.ToolTip="Add a playlist — point at any folder of MP3s (nothing is copied or moved)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                        <TextBlock Text="Add playlist" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MusicRemovePlaylistButton" Click="MusicRemovePlaylist_Click"
                                        Padding="10,5" Visibility="Collapsed"
                                        ToolTipService.ToolTip="Remove this playlist — the folder it points at is untouched">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                        <TextBlock Text="Remove" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="MusicHintText" FontSize="11" Opacity="0.6"
                                       TextWrapping="Wrap" MaxWidth="248" Visibility="Collapsed"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- Global (a window property, not per-agent): themes + window opacity. Last on the rail
                 since it's cosmetic and set-once. -->
            <Button x:Name="NavAppearance" Click="NavAppearance_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="Appearance — app-wide themes &amp; opacity">
                <FontIcon x:Name="NavAppearanceIcon" Glyph="&#xE771;" FontSize="16"/>
            </Button>
        </StackPanel>

        <!-- Integrated terminal toggle — pinned to the very bottom of the rail, VS-style.
             Slides a real shell panel up over the chat (Ctrl+`). -->
        <StackPanel Grid.Row="1" Padding="4,8" Spacing="6">
            <Border Background="{StaticResource MandoBorderBrush}" Height="1"
                    HorizontalAlignment="Stretch" Margin="8,2" Opacity="0.6"/>
            <Button x:Name="NavTerminal" Click="NavTerminal_Click" Padding="10,8" Background="Transparent"
                    BorderThickness="0" HorizontalAlignment="Stretch"
                    ToolTipService.ToolTip="Terminal — open a shell (Ctrl+`)">
                <FontIcon x:Name="NavTerminalIcon" Glyph="&#xE756;" FontSize="16"/>
            </Button>
        </StackPanel>
        </Grid>

        <!-- ======= Snapshots panel (global) =======
             A management surface for context snapshots, toggled from the rail. Docked left, ~37%
             wide, so the active chat stays visible on the right. Bound to the app-wide store. -->
        <Border x:Name="SnapshotsPanel" Grid.Column="1" Visibility="Collapsed"
                Background="{StaticResource MandoPanelBrush}"
                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="18,16,10,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Context snapshots" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="A snapshot is an AI-written summary of a conversation. Switching a model clears the chat, so snapshots let you save that context and carry it forward — Import one to hand it to another model or a fresh agent on its next message."
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Shown when no agent is open: Import arms an agent's next message, so it
                             needs one. Delete/search still work, so only Import disables. -->
                        <InfoBar x:Name="SnapshotsNoAgentNotice" Severity="Informational"
                                 IsOpen="False" IsClosable="False" Title="No agent open"
                                 Message="Open an agent to import a snapshot into its next message."/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CloseSnapshots_Click" Padding="6" Background="Transparent"
                            BorderThickness="0" VerticalAlignment="Top"
                            AutomationProperties.Name="Close snapshots" ToolTipService.ToolTip="Close">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Search — filters cards by title, recap text, model, or project. Hidden while the
                     store is empty (nothing to search) and collapses back to the empty note. -->
                <AutoSuggestBox x:Name="SnapshotsSearch" Grid.Row="1" Margin="18,0,18,10"
                                Visibility="Collapsed" QueryIcon="Find"
                                PlaceholderText="Search snapshots…"
                                TextChanged="SnapshotsSearch_TextChanged"/>

                <TextBlock x:Name="SnapshotsEmpty" Grid.Row="2" Visibility="Collapsed"
                           Text="No snapshots yet. When you switch a tab's model — or pick Take snapshot from a tab's ⋯ menu — you'll be offered to save the conversation as a snapshot, summarized by a model you choose."
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" Padding="18,8,18,18"/>

                <!-- One row per project, each an Expander so groups collapse individually — the
                     answer to "10-100 projects" is folding the ones you're not using. The outer
                     ListView virtualizes the group rows; collapsed state is remembered in code
                     across search/import (see _collapsedSnapshotGroups). -->
                <ScrollViewer x:Name="SnapshotsScroller" Grid.Row="2">
                    <ListView x:Name="SnapshotsList" SelectionMode="None" Padding="10,2,10,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SnapshotGroup">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{x:Bind IsExpanded}" Tag="{x:Bind}"
                                          Expanding="SnapshotGroup_Expanding" Collapsed="SnapshotGroup_Collapsed">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Opacity="0.7"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Project}" FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="7" Padding="6,0" VerticalAlignment="Center"
                                                    Background="{StaticResource MandoPanelBrush}">
                                                <TextBlock Text="{x:Bind Count}" FontSize="10" Opacity="0.7"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <!-- Group action, at the top of the group's CONTENT rather than
                                             its header: it only exists while the group is open, so it
                                             never crowds the collapse chevron, and it can carry a real
                                             label with the exact count instead of a bare icon.
                                             Hidden for a single-item group — that card's
                                             own Delete already does the same job. -->
                                        <Button Click="SnapshotDeleteGroup_Click" Tag="{x:Bind}"
                                                Visibility="{x:Bind DeleteAllVisibility}"
                                                HorizontalAlignment="Right" Margin="0,0,0,8" Padding="8,3"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Delete every snapshot shown in this project"
                                                AutomationProperties.Name="Delete every snapshot shown in this project">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Opacity="0.75"/>
                                                <TextBlock Text="{x:Bind DeleteAllLabel}" FontSize="11" Opacity="0.75"/>
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl ItemsSource="{x:Bind}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:ContextSnapshot">
                                                    <Border Background="{StaticResource MandoBackgroundBrush}" CornerRadius="8"
                                                            BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                                            Padding="12,10" Margin="0,0,0,6">
                                                        <StackPanel Spacing="6">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE722;" FontSize="13" VerticalAlignment="Center"
                                                                          Foreground="{StaticResource MandoAccentBrush}"/>
                                                                <TextBlock Text="{x:Bind DisplayTitle}" FontWeight="SemiBold" FontSize="13"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                           ToolTipService.ToolTip="{x:Bind OriginModel}"/>
                                                                <Border CornerRadius="5" Padding="6,0" VerticalAlignment="Center"
                                                                        Background="{StaticResource MandoPanelBrush}"
                                                                        ToolTipService.ToolTip="Model that wrote this recap">
                                                                    <TextBlock Text="{x:Bind SummarizerModel}" FontSize="10" Opacity="0.8"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE823;" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{x:Bind TimeLabel}" Opacity="0.55" FontSize="11"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="·" Opacity="0.4" FontSize="11" VerticalAlignment="Center"/>
                                                                <FontIcon Glyph="&#xE8BD;" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{x:Bind MessageCount}" Opacity="0.55" FontSize="11"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind Recap}" Opacity="0.75" FontSize="12"
                                                                       MaxLines="4" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Button FontSize="12" Padding="10,4"
                                                                        Click="SnapshotImport_Click" Tag="{x:Bind}"
                                                                        Loaded="SnapshotImport_Loaded"
                                                                        ToolTipService.ToolTip="Carry this recap into the active agent's next message">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                                                        <TextBlock Text="Import"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button FontSize="12" Padding="10,4"
                                                                        Click="SnapshotDelete_Click" Tag="{x:Bind}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                                        <TextBlock Text="Delete"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ======= History panel (global) =======
             Reopen a closed conversation. Shares Grid.Column 1 with the Snapshots panel (only one
             is ever visible), so it inherits the same slide animation. -->
        <Border x:Name="HistoryPanel" Grid.Column="1" Visibility="Collapsed"
                Background="{StaticResource MandoPanelBrush}"
                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="18,16,10,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="History" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Every conversation you close lands here. Reopen one as a new tab and it comes back with its transcript — and, when the model can take it, its full memory. Clearing a tab with /clear forgets it for good; closing keeps it."
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="CloseHistory_Click" Padding="6" Background="Transparent"
                            BorderThickness="0" VerticalAlignment="Top"
                            AutomationProperties.Name="Close history" ToolTipService.ToolTip="Close">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>

                <AutoSuggestBox x:Name="HistorySearch" Grid.Row="1" Margin="18,0,18,10"
                                Visibility="Collapsed" QueryIcon="Find"
                                PlaceholderText="Search past conversations…"
                                TextChanged="HistorySearch_TextChanged"/>

                <TextBlock x:Name="HistoryEmpty" Grid.Row="2" Visibility="Collapsed"
                           Text="No past conversations yet. Close a tab and it lands here."
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" Padding="18,8,18,18"/>

                <!-- Grouped by project into collapsible Expanders, same as Snapshots — the project
                     shows on the header, so the cards drop their own project line. Collapsed state
                     is remembered in code (see _collapsedHistoryGroups). -->
                <ScrollViewer x:Name="HistoryScroller" Grid.Row="2">
                    <ListView x:Name="HistoryList" SelectionMode="None" Padding="10,2,10,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:HistoryGroup">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{x:Bind IsExpanded}" Tag="{x:Bind}"
                                          Expanding="HistoryGroup_Expanding" Collapsed="HistoryGroup_Collapsed">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Opacity="0.7"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Project}" FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="7" Padding="6,0" VerticalAlignment="Center"
                                                    Background="{StaticResource MandoPanelBrush}">
                                                <TextBlock Text="{x:Bind Count}" FontSize="10" Opacity="0.7"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <!-- Group action, at the top of the group's CONTENT rather than
                                             its header: it only exists while the group is open, so it
                                             never crowds the collapse chevron, and it can carry a real
                                             label with the exact count instead of a bare icon.
                                             Hidden for a single-item group — that card's
                                             own Delete already does the same job. -->
                                        <Button Click="HistoryDeleteGroup_Click" Tag="{x:Bind}"
                                                Visibility="{x:Bind DeleteAllVisibility}"
                                                HorizontalAlignment="Right" Margin="0,0,0,8" Padding="8,3"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Delete every conversation shown in this project"
                                                AutomationProperties.Name="Delete every conversation shown in this project">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Opacity="0.75"/>
                                                <TextBlock Text="{x:Bind DeleteAllLabel}" FontSize="11" Opacity="0.75"/>
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl ItemsSource="{x:Bind}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:SessionArchiveEntry">
                                                    <Border Background="{StaticResource MandoBackgroundBrush}" CornerRadius="8"
                                                            BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                                            Padding="12,10" Margin="0,0,0,6">
                                                        <StackPanel Spacing="6">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE8BD;" FontSize="13" VerticalAlignment="Center"
                                                                          Foreground="{StaticResource MandoAccentBrush}"/>
                                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <Border CornerRadius="5" Padding="6,0" VerticalAlignment="Center"
                                                                        Background="{StaticResource MandoPanelBrush}"
                                                                        ToolTipService.ToolTip="Model this conversation ran on">
                                                                    <TextBlock Text="{x:Bind Model}" FontSize="10" Opacity="0.8"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE823;" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{x:Bind TimeLabel}" Opacity="0.55" FontSize="11"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text="·" Opacity="0.4" FontSize="11" VerticalAlignment="Center"/>
                                                                <FontIcon Glyph="&#xE8F2;" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{x:Bind TurnCount}" Opacity="0.55" FontSize="11"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <!-- The opening prompt: what this conversation was ABOUT. Two lines, not
                                                                 three — the card now carries three quotes, and the two below need the
                                                                 room more than a third line of the opening does. -->
                                                            <TextBlock Text="{x:Bind PreviewOrPlaceholder}" Opacity="0.75" FontSize="12"
                                                                       MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                                            <!-- Where the conversation stopped, in both voices: the user's LAST message
                                                                 and then the agent's LAST reply. Dimmer than the opening line, which is
                                                                 what identifies the row. The labels ("you" / "reply") are what tells the
                                                                 two apart — without them a bare second quote reads as more of the first.
                                                                 Each hides when there's nothing distinct to show (a single-turn
                                                                 conversation; a conversation the agent never answered) and for rows not
                                                                 yet backfilled. -->
                                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                                        Visibility="{x:Bind local:Vis.WhenText(LastMessage)}">
                                                                <TextBlock Text="you" FontSize="10" Opacity="0.4"
                                                                           VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{x:Bind LastMessage}" FontSize="11" Opacity="0.55"
                                                                           MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                                        Visibility="{x:Bind local:Vis.WhenText(LastReply)}">
                                                                <TextBlock Text="reply" FontSize="10" Opacity="0.4"
                                                                           VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{x:Bind LastReply}" FontSize="11" Opacity="0.55"
                                                                           MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <!-- Why a full-text search matched this row. Present only when the hit
                                                                 came from inside the conversation, which the title and preview above
                                                                 may not contain — an accented rule marks it as quoted from the
                                                                 transcript rather than more card metadata. -->
                                                            <Border Visibility="{x:Bind local:Vis.WhenText(MatchSnippet)}"
                                                                    BorderBrush="{StaticResource MandoAccentBrush}"
                                                                    BorderThickness="2,0,0,0" Padding="8,1,0,1">
                                                                <TextBlock Text="{x:Bind MatchSnippet}" FontSize="11" Opacity="0.7"
                                                                           FontStyle="Italic" MaxLines="2"
                                                                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Button FontSize="12" Padding="10,4"
                                                                        Click="HistoryOpen_Click" Tag="{x:Bind}"
                                                                        ToolTipService.ToolTip="Reopen this conversation as a new tab">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                                                                        <TextBlock Text="Open"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button FontSize="12" Padding="10,4"
                                                                        Click="HistoryDelete_Click" Tag="{x:Bind}"
                                                                        ToolTipService.ToolTip="Forget this conversation (deletes it for good)">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                                        <TextBlock Text="Delete"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ======= Notes panel =======
             Notes live in the project, not in the app: each one is a plain text file under
             <project>\notes\, so it's in the file tree, in git if you want it there, and reachable by
             the agent as @notes/whatever.txt. Nothing is pre-created — a project has a notes folder
             only once you've written a note there with an agent open.

             The panel has two states in one column: the browse list (grouped by project, searchable)
             and the editor, which replaces it while a note is open. Shares Grid.Column 1 with the
             Snapshots and History panels, so it inherits their slide animation. -->
        <Border x:Name="NotesPanel" Grid.Column="1" Visibility="Collapsed"
                Background="{StaticResource MandoPanelBrush}"
                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="18,16,10,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Notes" FontSize="16" FontWeight="SemiBold"/>
                            <!-- Collapsed while a note is open: at this width, every line of chrome
                                 is a line taken from what you're writing. -->
                            <TextBlock x:Name="NotesBlurb"
                                       Text="A jot pad that's always here — plain text files in ~\.mandocode\notes, yours to grep, sync, or open in any editor. New notes are filed under the folder you're working in when there is one. The prompt at the bottom can read what you've written; nothing it says reaches a note unless you insert it."
                                       Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                        <Button x:Name="NotesNewButton" Click="NoteNew_Click" Padding="8,5"
                                Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="New note"
                                ToolTipService.ToolTip="New note — filed under the folder you're working in, if any">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                <TextBlock Text="New" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Click="CloseNotes_Click" Padding="6" Background="Transparent"
                                BorderThickness="0"
                                AutomationProperties.Name="Close notes" ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Searches note names AND bodies — you remember what you wrote, not what you
                     called it. Matching lines are quoted on the card (see MatchSnippet). -->
                <AutoSuggestBox x:Name="NotesSearch" Grid.Row="1" Margin="18,0,18,10"
                                Visibility="Collapsed" QueryIcon="Find"
                                PlaceholderText="Search notes…"
                                TextChanged="NotesSearch_TextChanged"/>

                <TextBlock x:Name="NotesEmpty" Grid.Row="2" Visibility="Collapsed"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" Padding="18,8,18,18"/>

                <ScrollViewer x:Name="NotesScroller" Grid.Row="2">
                    <ListView x:Name="NotesList" SelectionMode="None" Padding="10,2,10,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NoteGroup">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsExpanded="{x:Bind IsExpanded}" Tag="{x:Bind}"
                                          Expanding="NoteGroup_Expanding" Collapsed="NoteGroup_Collapsed">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" Opacity="0.7"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Project}" FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="7" Padding="6,0" VerticalAlignment="Center"
                                                    Background="{StaticResource MandoPanelBrush}">
                                                <TextBlock Text="{x:Bind Count}" FontSize="10" Opacity="0.7"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{x:Bind}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:NoteRow">
                                                <Border Background="{StaticResource MandoBackgroundBrush}" CornerRadius="8"
                                                        BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                                        Padding="12,10" Margin="0,0,0,6">
                                                    <StackPanel Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE70B;" FontSize="13" VerticalAlignment="Center"
                                                                      Foreground="{StaticResource MandoAccentBrush}"/>
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       ToolTipService.ToolTip="{x:Bind FileName}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE823;" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{x:Bind TimeLabel}" Opacity="0.55" FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="·" Opacity="0.4" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{x:Bind SizeLabel}" Opacity="0.55" FontSize="11"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind PreviewOrPlaceholder}" Opacity="0.75" FontSize="12"
                                                                   MaxLines="3" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                                        <!-- Why a body search matched, quoted from the note. -->
                                                        <Border Visibility="{x:Bind local:Vis.WhenText(MatchSnippet)}"
                                                                BorderBrush="{StaticResource MandoAccentBrush}"
                                                                BorderThickness="2,0,0,0" Padding="8,1,0,1">
                                                            <TextBlock Text="{x:Bind MatchSnippet}" FontSize="11" Opacity="0.7"
                                                                       FontStyle="Italic" MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Button FontSize="12" Padding="10,4"
                                                                    Click="NoteOpen_Click" Tag="{x:Bind Note}"
                                                                    AutomationProperties.Name="Open note"
                                                                    ToolTipService.ToolTip="Open this note for editing">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                                                                    <TextBlock Text="Open"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button FontSize="12" Padding="10,4"
                                                                    Click="NoteDelete_Click" Tag="{x:Bind Note}"
                                                                    AutomationProperties.Name="Delete note"
                                                                    ToolTipService.ToolTip="Delete this note from disk">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                                    <TextBlock Text="Delete"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <!-- The editor, in the same row as the list: one of the two is ever visible. -->
                <controls:NoteEditorPane x:Name="NoteEditor" Grid.Row="2" Visibility="Collapsed"/>

                <!-- Always-present prompt. The document above it is your note (or the list of them)
                     rather than a transcript, so replies land in the bar's own strip and only reach a
                     note via Insert/Replace. The assistant behind it has no tools at all, which is what
                     makes "nothing writes your note but you" structural rather than a promise. -->
                <controls:NoteAskBar x:Name="NoteAsk" Grid.Row="3"
                                     BorderBrush="{StaticResource MandoBorderBrush}"
                                     BorderThickness="0,1,0,0"/>
            </Grid>
        </Border>

        <Grid x:Name="ContentColumnGrid" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="TerminalRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- Drag handle to resize the terminal — VS-style splitter on its top edge.
                 ResizeGrip shows the ↕ cursor on hover; the drag is driven by pointer events.
                 Collapsed (0px) until the panel is open. -->
            <controls:ResizeGrip x:Name="TerminalSplitter" Grid.Row="2" Height="6" Visibility="Collapsed"
                                 HorizontalAlignment="Stretch" Background="Transparent"
                                 PointerPressed="TerminalSplitter_PointerPressed"
                                 PointerMoved="TerminalSplitter_PointerMoved"
                                 PointerReleased="TerminalSplitter_PointerReleased"/>

            <!-- The sliding integrated terminal is created lazily in code (MainWindow.EnsureTerminal)
                 the first time it's opened, and dropped into Grid.Row 3 — so no WebView2/shell spins
                 up until the user actually asks for a terminal. -->

        <!-- ======= Agent tab strip =======
             The strip carries headers ONLY — each agent's content lives in TabHost below and is
             toggled by Visibility, never re-parented. WinUI's TabView hosts just the selected
             item's content, which would detach a background agent's WebView2 and close its
             CoreWebView2 — and the transcript DOM is the only copy of that conversation. -->
        <!-- Extra top padding balances the reserved scrollbar lane at the bottom of the tab
             content, so the tabs sit visually centered in the strip. -->
        <StackPanel Grid.Row="0">
        <Border Background="{StaticResource MandoPanelBrush}" Padding="10,13,10,6"
                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- brand -->
                    <ColumnDefinition Width="Auto"/>   <!-- divider -->
                    <ColumnDefinition Width="*"/>      <!-- tabs (scrolls) -->
                    <ColumnDefinition Width="Auto"/>   <!-- divider -->
                    <ColumnDefinition Width="Auto"/>   <!-- permanent add button -->
                </Grid.ColumnDefinitions>

                <!-- Bottom margin mirrors the tab content's scrollbar lane so the title centers in
                     the same region as the (top-aligned) tabs, instead of sitting lower. -->
                <TextBlock Text="MandoCode" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,0,18" Foreground="{StaticResource MandoAccentBrush}"/>

                <!-- Vertical divider between the brand and the agent tabs. Insets align it with the
                     tab band (bottom inset matches the tabs' scrollbar lane). -->
                <Rectangle Grid.Column="1" Width="1" VerticalAlignment="Stretch" Margin="0,4,0,22"
                           Fill="{StaticResource MandoBorderBrush}"/>

                <!-- Visible horizontal scrollbar, but the scroll content carries a bottom margin so
                     WinUI's auto-hide overlay bar sits in that reserved lane BELOW the tabs instead
                     of drawing on top of them. Mouse wheel / touchpad scroll horizontally too. -->
                <ScrollViewer x:Name="TabScroller" Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                              SizeChanged="TabScroller_SizeChanged"
                              PointerWheelChanged="TabScroller_PointerWheelChanged">
                    <!-- Bottom lane (Margin) for the scrollbar. Sized for the HIGHLIGHTED (hover/drag)
                         bar, which grows upward — a thinner lane clears the idle bar but the expanded
                         one would reach into the tabs. -->
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Top" Margin="0,0,0,18"
                                SizeChanged="TabStrip_SizeChanged"/>
                </ScrollViewer>

                <!-- Vertical divider between the tabs and the add button (mirrors the brand-side rule). -->
                <Rectangle Grid.Column="3" Width="1" VerticalAlignment="Stretch" Margin="0,4,0,22"
                           Fill="{StaticResource MandoBorderBrush}"/>

                <!-- PERMANENT buttons, pinned far right (opposite the brand) and OUTSIDE the
                     scroller, so they never scroll out of reach when many agents are open. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="0,0,0,18">
                    <!-- Split view: 2–4 agents at once. Needs ≥2 agents (disabled otherwise);
                         further panes are added from the split bar or a tab's menu. -->
                    <Button x:Name="SplitButton" Click="SplitButton_Click" Padding="10,6"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Split view — show 2 to 4 agents at once"
                            AutomationProperties.Name="Split view">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon x:Name="SplitButtonIcon" Glyph="&#xE7C4;" FontSize="12"/>
                            <TextBlock Text="Split" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddTabButton" Click="AddTab_Click" Padding="10,6"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" ToolTipService.ToolTip="Add agent"
                            AutomationProperties.Name="New agent">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock Text="New agent" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======= Split bar =======
             Shown only in split mode. Left: label + one chip per pane (built by RefreshSplitBar).
             Right: Add pane / Exit split view, pinned under the toolbar's matching pair.
             Lives in the top chrome (not TabHost) so the panes below need no extra rows.
             Chips use MenuFlyout rather than ComboBox on purpose: rebuilding ComboBox items as
             containers throws COMException 0x80070490 (see MainWindow.Split.cs). -->
        <!-- Right padding matches the toolbar Border's (10) so the pinned buttons below line up
             edge-for-edge with Split / New agent above. -->
        <Border x:Name="SplitBar" Visibility="Collapsed" Background="{StaticResource MandoPanelBrush}"
                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,7,10,7">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>      <!-- label + pane chips (scrolls) -->
                    <ColumnDefinition Width="Auto"/>   <!-- layout hint -->
                    <ColumnDefinition Width="Auto"/>   <!-- permanent buttons -->
                </Grid.ColumnDefinitions>

                <!-- Label and chips scroll together, so four chips on a narrow window can never
                     push the pinned buttons off the bar. -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7C4;" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                        <TextBlock Text="Split view" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <!-- One chip per pane, in pane order. Rebuilt by RefreshSplitBar. -->
                        <StackPanel x:Name="PaneChips" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Outside the scroller, so the shape stays readable however many chips there are. -->
                <TextBlock x:Name="PaneLayoutHint" Grid.Column="1" FontSize="11" Opacity="0.45"
                           VerticalAlignment="Center"/>

                <!-- PERMANENT buttons, pinned far right directly beneath the toolbar's Split /
                     New agent pair — same borderless look, same padding, same 4px spacing — and
                     outside the scroller so they never scroll out of reach. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <!-- Primary click panes the next agent that isn't shown yet; the chevron picks
                         a specific one (same shape as TerminalPanel's NewTerminalButton). -->
                    <SplitButton x:Name="AddPaneButton" Click="AddPane_Click" Padding="10,6"
                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="Add another agent as a pane (up to 4)"
                                 AutomationProperties.Name="Add pane">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            <TextBlock Text="Add pane" FontSize="13"/>
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout x:Name="AddPaneMenu" Placement="Bottom"/>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button Click="ExitSplit_Click" Padding="10,6" Background="Transparent"
                            BorderThickness="0" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Leave split view and show one agent"
                            AutomationProperties.Name="Exit split view">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                            <TextBlock Text="Exit split view" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>

        <!-- ======= Page host =======
             Settings and MCP are declared here and take the full area when selected; agent views
             are added at runtime. Exactly one child is Visible; the rest stay loaded and Collapsed. -->
        <Grid x:Name="TabHost" Grid.Row="1">
                <!-- Rows and columns for split view are OWNED BY CODE — MainWindow.Split.cs
                     rebuilds them per pane count (2 = 1x2, 3 = 1x3, 4 = 2x2), interleaving a divider
                     track between adjacent panes. Out of split mode it collapses back to the single
                     */* cell declared here, so pages and the empty state need no grid awareness.
                     Agent views move between cells via Grid.SetColumn/SetRow, which does NOT
                     reparent them, so their WebViews survive the switch. Dividers are created and
                     destroyed as children, which likewise never touches an agent view. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============ EMPTY STATE ============
                     Shown when every agent has been closed — the chat area is just the background
                     with a nudge back in. The tab strip's "New agent" button stays live above, and
                     this offers the same. Settings/MCP need an agent, so their rail buttons disable
                     until one exists. -->
                <!-- The custom chat background image, mirrored at the window level for the empty
                     state (in a live tab it lives inside the transcript WebView). Same file and
                     opacity as the transcript; hidden when no image is set or an agent is open. -->
                <!-- Full-area children span every pane track. Spans beyond the current track count
                     are clamped by the Grid, so one generous span covers all four layouts. -->
                <Image x:Name="EmptyBgImage" Visibility="Collapsed" Stretch="UniformToFill"
                       Grid.ColumnSpan="5" Grid.RowSpan="3"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <StackPanel x:Name="EmptyAgentsState" Visibility="Collapsed"
                            Grid.ColumnSpan="5" Grid.RowSpan="3"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="14" MaxWidth="360">
                    <FontIcon Glyph="&#xE8BD;" FontSize="40" HorizontalAlignment="Center"
                              Foreground="{StaticResource MandoAccentBrush}" Opacity="0.85"/>
                    <TextBlock Text="No agents open" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="You've closed every agent. Start a new one to begin a conversation — your snapshots and closed conversations are still saved in the rail."
                               Opacity="0.6" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Click="AddTab_Click" HorizontalAlignment="Center" Padding="14,7"
                            Background="{StaticResource MandoAccentBrush}" BorderThickness="0"
                            AutomationProperties.Name="New agent">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White"/>
                            <TextBlock Text="New agent" FontSize="13" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ============ SETTINGS PAGE ============ -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed" Padding="24,16,24,16" RowSpacing="12"
                      Grid.ColumnSpan="5" Grid.RowSpan="3">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SettingsPageTransform"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource MandoAccentBrush}"/>
                            <Border Background="{StaticResource MandoPanelBrush}"
                                    BorderBrush="{StaticResource MandoSkyBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock x:Name="SettingsAgentChip" Text="" FontSize="12"
                                           Foreground="{StaticResource MandoSkyBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="These settings belong to the selected agent, for this session — another agent keeps its own."
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <SelectorBar Grid.Row="1" x:Name="SettingsTabs" SelectionChanged="SettingsTabs_SelectionChanged">
                        <SelectorBarItem x:Name="Tab_Model" Text="Model"/>
                        <SelectorBarItem x:Name="Tab_Behavior" Text="Behavior"/>
                        <SelectorBarItem x:Name="Tab_Integrations" Text="Integrations"/>
                    </SelectorBar>

                    <ScrollViewer Grid.Row="2">
                        <Grid>
                            <StackPanel x:Name="TabPanel_Model" Visibility="Collapsed" Spacing="14" MaxWidth="680"
                                        HorizontalAlignment="Left" Padding="0,4,0,8">
                                <TextBlock Text="Connection" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MandoAccentBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="RunSetupWizard_Click"
                                            ToolTipService.ToolTip="Guided setup: reach Ollama, install or start it if needed, and pick a model — the same wizard that runs on first launch.">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE945;" FontSize="13"/>
                                            <TextBlock Text="Run guided setup"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="walks through connection + model, like first launch"
                                               VerticalAlignment="Center" FontSize="12" Opacity="0.6"/>
                                </StackPanel>
                                <TextBlock Text="Ollama endpoint" FontSize="13" Opacity="0.8"/>
                                <TextBox x:Name="EndpointBox" PlaceholderText="http://localhost:11434" MinWidth="560"
                                         HorizontalAlignment="Left"
                                         ToolTipService.ToolTip="Where the Ollama server listens. Every model request goes here — point it at another machine or port to run the model remotely."/>
                                <TextBlock Text="Model" FontSize="13" Opacity="0.8"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ModelCombo" IsEditable="True" HorizontalAlignment="Stretch"
                                              PlaceholderText="e.g. qwen2.5-coder:14b" MinWidth="512"
                                              ToolTipService.ToolTip="The model that powers every response. Bigger models reason better but respond slower and need more memory; coder-tuned models follow tool-calling instructions most reliably."/>
                                    <Button Grid.Column="1" Click="RefreshModels_Click"
                                            ToolTipService.ToolTip="Fetch pulled models">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Save &amp; Reconnect" Click="SettingsSave_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            ToolTipService.ToolTip="Apply the endpoint and model above, then reconnect to Ollama."/>
                                    <TextBlock x:Name="ModelListStatus" Text="" VerticalAlignment="Center"
                                               FontSize="12" Opacity="0.7"/>
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource MandoBorderBrush}" Margin="0,4"/>
                                <TextBlock Text="Generation" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MandoAccentBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="S_Temperature" Header="Temperature" Minimum="0" Maximum="1"
                                            StepFrequency="0.05" ValueChanged="Temperature_Changed"
                                            ToolTipService.ToolTip="Controls randomness. Low = precise, repeatable answers (best for coding); high = more creative but less reliable tool calls. 0.2–0.4 is a good coding range."/>
                                    <TextBlock x:Name="S_TemperatureLabel" Grid.Column="1" VerticalAlignment="Bottom"
                                               Margin="0,0,0,8" Opacity="0.7" FontSize="13" MinWidth="36"/>
                                </Grid>
                                <NumberBox x:Name="S_MaxTokens" Header="Max response tokens" Tag="maxTokens"
                                           Minimum="1" SpinButtonPlacementMode="Compact" SmallChange="1024"
                                           ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                                           ToolTipService.ToolTip="Upper limit on how long a single response can be. Raise it if answers get cut off mid-code; lower it for shorter, faster replies."/>
                                <NumberBox x:Name="S_ContextLength" Header="Context window (tokens, 0 = Ollama default)"
                                           Tag="contextLength" Minimum="0" SpinButtonPlacementMode="Compact" SmallChange="2048"
                                           ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                                           ToolTipService.ToolTip="How much conversation and file content the model can see at once. Larger windows track big files and long chats but use much more RAM/VRAM and respond slower. 0 keeps Ollama's default."/>
                                <TextBlock Text="Sent with every request (num_ctx), so it applies from this agent's next message — no restart needed. Auto-sized to the model's hardware tier when you switch models; set it here to override."
                                           Opacity="0.5" FontSize="11" TextWrapping="Wrap" Margin="0,-6,0,0"/>
                                <ComboBox x:Name="S_Streaming" Header="Response streaming" SelectionChanged="Streaming_Changed"
                                          HorizontalAlignment="Stretch"
                                          ToolTipService.ToolTip="Which models use the streaming transport under the hood. Streamed chunks feed the stall watchdog, so long generations aren't mistaken for a stalled model. Text still appears per completed turn either way — 'all' is the most reliable choice.">
                                    <x:String>all</x:String>
                                    <x:String>cloud</x:String>
                                    <x:String>off</x:String>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="TabPanel_Behavior" Visibility="Collapsed" Spacing="14" MaxWidth="680"
                                        HorizontalAlignment="Left" Padding="0,4,0,8">
                                <TextBlock Text="Behavior" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MandoAccentBrush}"/>
                                <!-- App-wide (naming happens in SessionManager before any agent exists), unlike
                                     the rest of this tab — the header says so. Applies to agents opened after
                                     the change; existing tabs keep their names. -->
                                <ToggleSwitch x:Name="S_AgentCallsigns" Header="Callsign names for new agents — app-wide"
                                              Toggled="AgentCallsigns_Toggled"
                                              ToolTipService.ToolTip="Off: new agents are Agent 1, Agent 2, … On: each new agent draws a random callsign — Morphy, Kernel, Cloud — from a 500-name deck that doesn't repeat until it runs dry. Renaming a tab always works either way."/>
                                <ToggleSwitch x:Name="S_TaskPlanning" Header="Task planning (propose_plan for multi-step requests)"
                                              Tag="taskPlanning" Toggled="Setting_Toggled"
                                              ToolTipService.ToolTip="For multi-step requests the model first proposes a numbered plan you approve before any work starts. More predictable on big tasks; an extra step on small ones."/>
                                <ToggleSwitch x:Name="S_DiffApprovals" Header="Diff approvals (review writes, deletes, and commands)"
                                              Tag="diffApprovals" Toggled="Setting_Toggled"
                                              ToolTipService.ToolTip="The AI must show you a diff and get your approval before writing files, deleting, or running commands. Off = changes apply instantly with no review — only for full trust."/>
                                <ToggleSwitch x:Name="S_AutoContinue" Header="Auto-continue past tool budget limits"
                                              Tag="autoContinue" Toggled="Setting_Toggled"
                                              ToolTipService.ToolTip="When a request exhausts its tool budget mid-task, MandoCode automatically tells the model to keep going instead of stopping to ask you."/>
                                <NumberBox x:Name="S_MaxContinuations" Header="Max auto-continuations per request" Tag="maxContinuations"
                                           Minimum="0" SpinButtonPlacementMode="Compact" SmallChange="1"
                                           ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                                           ToolTipService.ToolTip="Safety cap on auto-continue — stops a model that never finishes from looping forever."/>

                                <Border Height="1" Background="{StaticResource MandoBorderBrush}" Margin="0,4"/>
                                <TextBlock Text="Limits" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource MandoAccentBrush}"/>
                                <NumberBox x:Name="S_RequestTimeout" Header="Per-request timeout (minutes)" Tag="timeout"
                                           Minimum="1" SpinButtonPlacementMode="Compact" SmallChange="1"
                                           ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                                           ToolTipService.ToolTip="Hard ceiling for one whole request — every model call and tool run combined. Raise it for big tasks on slow hardware; lower it to fail fast."/>
                                <NumberBox x:Name="S_StallTimeout" Header="Stall watchdog per model call (seconds)" Tag="modelResponseTimeout"
                                           Minimum="5" SpinButtonPlacementMode="Compact" SmallChange="30"
                                           ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                                           ToolTipService.ToolTip="How long a single model call may stay silent before MandoCode treats it as stalled and aborts. Raise it if large models on slow hardware get killed while still thinking."/>
                                <NumberBox x:Name="S_ToolBudget" Header="Tool-result character budget per request" Tag="toolBudget"
                                           Minimum="1000" SpinButtonPlacementMode="Compact" SmallChange="50000"
                                           ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                                           ToolTipService.ToolTip="Max characters of tool output (file reads, command results) fed back to the model in one request. Higher = the model sees more of your project, but responses slow down and can overflow small context windows."/>
                                <NumberBox x:Name="S_RenderTimeout" Header="Markdown render timeout (seconds)" Tag="renderTimeout"
                                           Minimum="1" SpinButtonPlacementMode="Compact" SmallChange="10"
                                           ValueChanged="Setting_NumberChanged" HorizontalAlignment="Stretch"
                                           ToolTipService.ToolTip="How long to spend turning a response into rich formatting before falling back to plain text. Purely cosmetic — never changes what the model says."/>
                            </StackPanel>

                            <StackPanel x:Name="TabPanel_Integrations" Visibility="Collapsed" Spacing="14" MaxWidth="680"
                                        HorizontalAlignment="Left" Padding="0,4,0,8">
                                <ToggleSwitch x:Name="S_WebSearch" Header="Web search" Tag="webSearch" Toggled="Setting_Toggled"
                                              ToolTipService.ToolTip="Gives the model a web-search tool for current information. Off = it only knows its training data and your project files."/>
                                <TextBlock Text="Tavily API key (optional — more reliable web search; free at app.tavily.com)"
                                           FontSize="13" Opacity="0.8" TextWrapping="Wrap"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="S_TavilyKey" PlaceholderText="tvly-…" MinWidth="512"
                                                 PasswordRevealMode="Hidden" PasswordChanged="TavilyKey_Changed"
                                                 ToolTipService.ToolTip="With a key, web searches use Tavily's structured results instead of the built-in scraper — cleaner sources for the model, so better-grounded answers."/>
                                    <Button Grid.Column="1" x:Name="TavilyViewButton" Content="View" IsEnabled="False"
                                            Click="TavilyView_Click"
                                            ToolTipService.ToolTip="Show or hide the key"/>
                                    <Button Grid.Column="2" Content="Save key" Click="TavilySave_Click"
                                            ToolTipService.ToolTip="Save this key to the shared MandoCode config (type 'clear' to remove the saved key)"/>
                                </Grid>
                                <TextBlock Text="MCP servers are managed on the MCP page (rail), where each agent also opts in to using their tools."
                                           Opacity="0.5" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Grid Grid.Row="3" ColumnSpacing="14" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SettingsStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MandoGoldBrush}"/>

                        <Button Grid.Column="1" x:Name="ResetTabButton" Click="ResetTab_Click"
                                ToolTipService.ToolTip="Reset this tab's settings to the app's factory defaults (this agent only). Leaves the connection endpoint/model and your Tavily key untouched.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="13"/>
                                <TextBlock x:Name="ResetTabButtonText" Text="Reset tab"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" x:Name="MakeDefaultButton" Click="MakeDefault_Click"
                                ToolTipService.ToolTip="Write this agent's settings to ~/.mandocode/config.json as the starting point for every new agent. Agents already open keep their own.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="13"/>
                                <TextBlock Text="Make Default for New Agents"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ============ APPEARANCE PAGE ============
                     App-wide (a window property), so it lives on the rail rather than in the
                     per-agent Settings tabs. -->
                <Grid x:Name="AppearancePage" Visibility="Collapsed" Padding="24,16,24,16" RowSpacing="12"
                      Grid.ColumnSpan="5" Grid.RowSpan="3">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="AppearancePageTransform"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource MandoAccentBrush}"/>
                        <TextBlock Text="App-wide, not per-agent. Saved on this machine only; never touches the shared CLI config."
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Two-pane layout: themes always visible on the left; chat background and
                         window opacity always open on the right. No collapsing cards — the whole
                         page is on screen at once, which is quicker to navigate. -->
                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: theme picker, always open. The ListView scrolls internally. -->
                        <Border Grid.Column="0" Background="{StaticResource MandoPanelBrush}"
                                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" FontSize="16"/>
                                    <TextBlock Text="Theme" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ThemeHeaderValue" Opacity="0.6" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Themes restyle everything, transcripts included."
                                           Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                                <ListView Grid.Row="2" x:Name="ThemeList" SelectionMode="Single"
                                          SelectionChanged="ThemeList_SelectionChanged" Margin="0,4,0,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ThemeVm">
                                        <Border Background="{x:Bind BgBrush}" BorderBrush="{x:Bind EdgeBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" Foreground="{x:Bind FgBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind Description}" Foreground="{x:Bind DimBrush}"
                                                               FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="14" Height="14" Fill="{x:Bind AccentBrush}"/>
                                                    <Ellipse Width="14" Height="14" Fill="{x:Bind GoldBrush}"/>
                                                    <Ellipse Width="14" Height="14" Fill="{x:Bind SkyBrush}"/>
                                                    <Ellipse Width="14" Height="14" Fill="{x:Bind GreenBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- RIGHT: chat background (top) + window opacity (below), both always open. -->
                        <ScrollViewer Grid.Column="1">
                            <StackPanel Spacing="16">
                                <!-- Chat background -->
                                <Border Background="{StaticResource MandoPanelBrush}"
                                        BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                                            <TextBlock Text="Chat background" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="BgFileLabel" Text="No image set" Opacity="0.6"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Shown behind the conversation in every agent tab. The slider fades the image only — text always stays fully readable."
                                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>

                                        <!-- Live preview: a REAL miniature transcript (same shell, CSS, and theme
                                             script as the chat), so it renders exactly what the tabs render —
                                             background image + opacity, boxed messages, E-Ink dithering, W98 teal,
                                             and whatever theme features come next. It can never drift again. -->
                                        <Border Height="260" CornerRadius="8"
                                                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                                Background="{StaticResource MandoBackgroundBrush}">
                                            <WebView2 x:Name="BgPreviewWeb" DefaultBackgroundColor="Transparent"/>
                                        </Border>

                                        <!-- Backgrounds that ship with the release, so a fresh install has
                                             something to pick without hunting for a file. The tiles are
                                             whatever images are in Assets/images/backgrounds (see
                                             BuiltInBackgrounds) — adding one in a future release needs no
                                             change here. The whole block hides when a build ships none,
                                             leaving "Choose image…" exactly as it was. -->
                                        <StackPanel x:Name="BgBuiltInPanel" Spacing="6" Visibility="Collapsed">
                                            <TextBlock x:Name="BgBuiltInHeader" Text="Included with MandoCode"
                                                       FontSize="12" Opacity="0.6"/>
                                            <ItemsRepeater x:Name="BgBuiltInList">
                                                <ItemsRepeater.Layout>
                                                    <!-- Wraps rather than scrolling, so a future fourth or fifth
                                                         image flows onto a second row instead of off the edge. -->
                                                    <UniformGridLayout MinItemWidth="140" MinItemHeight="104"
                                                                       MinRowSpacing="8" MinColumnSpacing="8"/>
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="local:BackgroundChoiceVm">
                                                        <Button Click="BgBuiltIn_Click" Tag="{x:Bind}"
                                                                Padding="3" CornerRadius="9"
                                                                Background="Transparent"
                                                                BorderBrush="{x:Bind RingBrush}"
                                                                BorderThickness="{x:Bind RingThickness}"
                                                                ToolTipService.ToolTip="{x:Bind DisplayName}"
                                                                AutomationProperties.Name="{x:Bind DisplayName}">
                                                            <StackPanel Spacing="4">
                                                                <Grid>
                                                                    <Border CornerRadius="6" Width="124" Height="70">
                                                                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                                                                    </Border>
                                                                    <!-- Check badge: the ring alone is easy to miss on a
                                                                         busy image, and it has to survive the light themes. -->
                                                                    <Border Visibility="{x:Bind CheckVisibility}"
                                                                            Background="{StaticResource MandoAccentBrush}"
                                                                            CornerRadius="9" Width="18" Height="18"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                            Margin="0,4,4,0">
                                                                        <FontIcon Glyph="&#xE73E;" FontSize="10"
                                                                                  Foreground="White"/>
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="11"
                                                                           Opacity="0.75" MaxWidth="124"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="BgChooseButton" Content="Choose image…" Click="BgChoose_Click"/>
                                            <Button x:Name="BgClearButton" Content="Remove" Click="BgClear_Click"/>
                                        </StackPanel>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="S_BgOpacity" Header="Image opacity" Minimum="5" Maximum="100"
                                                    Value="30" ValueChanged="BgOpacity_Changed"
                                                    ToolTipService.ToolTip="How strongly the image shows through. Lower it if text gets hard to read — the text itself never fades."/>
                                            <TextBlock x:Name="S_BgOpacityLabel" Grid.Column="1" Text="30%"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,8" Opacity="0.7"
                                                       FontSize="13" MinWidth="44"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Boxed messages -->
                                <Border Background="{StaticResource MandoPanelBrush}"
                                        BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8A9;" FontSize="16"/>
                                            <TextBlock Text="Boxed messages" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Each prompt and response gets its own card in the conversation — clearer boundaries for long sessions. Off keeps the classic flat terminal look. Works with every theme."
                                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                                        <ToggleSwitch x:Name="BoxedMessagesToggle" Toggled="BoxedMessages_Toggled"
                                                      OnContent="Cards" OffContent="Flat"/>
                                    </StackPanel>
                                </Border>

                                <!-- Window opacity -->
                                <Border Background="{StaticResource MandoPanelBrush}"
                                        BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE706;" FontSize="16"/>
                                            <TextBlock Text="Window opacity" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="S_WindowOpacityLabel" Text="100%" Opacity="0.6"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Makes the whole window translucent so you can see what's behind it. 100% = solid (default). Purely visual — never affects the model."
                                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                                        <Slider x:Name="S_WindowOpacity" Minimum="30" Maximum="100" Value="100"
                                                HorizontalAlignment="Stretch"
                                                ValueChanged="WindowOpacity_Changed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ============ MCP PAGE ============ -->
                <Grid x:Name="McpPage" Visibility="Collapsed" Padding="24,16,24,24" RowSpacing="12"
                      Grid.ColumnSpan="5" Grid.RowSpan="3">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="McpPageTransform"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MCP Servers" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource MandoAccentBrush}"/>
                        <Border Grid.Column="1" Background="{StaticResource MandoPanelBrush}"
                                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="shared by every agent" FontSize="12" Opacity="0.7"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="MCP servers connect the AI to outside systems — databases, APIs, docs, other apps — as tools it can call during a chat. Servers are shared by every agent; toggle each one on or off below. Changes save immediately."
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                        <AutoSuggestBox x:Name="McpSearchBox" QueryIcon="Find" Margin="0,4,0,0"
                                        PlaceholderText="Search servers by name or transport…"
                                        TextChanged="McpSearch_TextChanged"
                                        ToolTipService.ToolTip="Filter the list below by name or transport"/>
                    </StackPanel>

                    <ListView Grid.Row="3" x:Name="McpList" SelectionMode="Single"
                              SelectionChanged="McpList_SelectionChanged" DoubleTapped="McpList_DoubleTapped"
                              Background="{StaticResource MandoPanelBrush}"
                              BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                              CornerRadius="8">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12"
                                                   Opacity="0.6" Margin="4,10,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:McpRow">
                                <Grid Padding="4,8" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Per-server on/off (shared by every agent). Tag carries the name
                                         so the handler knows which server without relying on selection. -->
                                    <ToggleSwitch IsOn="{x:Bind Enabled}" Tag="{x:Bind Name}"
                                                  Toggled="McpEnabled_Toggled" OnContent="" OffContent=""
                                                  MinWidth="0" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="Enable or disable this server for every agent"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold"
                                               FontFamily="Cascadia Code,Consolas" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Transport}" Opacity="0.6" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Status}" Foreground="{x:Bind StatusBrush}"
                                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Each button's content is an icon + label panel, so it exposes no accessible
                         name on its own. AutomationProperties.Name gives screen readers (and UI
                         tests) something to address. -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="McpAddButton" Click="McpAdd_Click" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="Add MCP Server"
                                ToolTipService.ToolTip="Add a new MCP server">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Add MCP Server"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="McpEditButton" Click="McpEdit_Click" IsEnabled="False"
                                AutomationProperties.Name="Edit MCP Server"
                                ToolTipService.ToolTip="Edit the selected server (or double-click a row)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                <TextBlock Text="Edit"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="McpRemoveButton" Click="McpRemove_Click" IsEnabled="False"
                                AutomationProperties.Name="Remove MCP Server"
                                ToolTipService.ToolTip="Remove the selected server from config">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                <TextBlock Text="Remove"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="McpReloadButton" Click="McpReload_Click"
                                AutomationProperties.Name="Restart Servers"
                                ToolTipService.ToolTip="Stop and restart every MCP server process/connection, then re-register their tools with every agent. Use when a server is stuck or its tools changed.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE895;" FontSize="13"/>
                                <TextBlock Text="Restart Servers"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="McpRefreshButton" Click="McpRefresh_Click"
                                AutomationProperties.Name="Refresh MCP status"
                                ToolTipService.ToolTip="Refresh this status list only — doesn't touch the servers">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                        <!-- Divider between the action group and the filter group. -->
                        <Border Width="1" Margin="0,4" VerticalAlignment="Stretch"
                                Background="{StaticResource MandoBorderBrush}" Opacity="0.6"/>
                        <ToggleButton x:Name="McpFilterAll" Content="All" IsChecked="True" Tag="all" Click="McpFilter_Click"
                                      ToolTipService.ToolTip="Show every server"/>
                        <ToggleButton x:Name="McpFilterEnabled" Content="Enabled" Tag="enabled" Click="McpFilter_Click"
                                      ToolTipService.ToolTip="Show only enabled servers (running and shared with every agent)"/>
                        <ToggleButton x:Name="McpFilterDisabled" Content="Disabled" Tag="disabled" Click="McpFilter_Click"
                                      ToolTipService.ToolTip="Show only disabled servers (turned off, not connected)"/>
                        <ToggleButton x:Name="McpFilterFailed" Content="Failed" Tag="failed" Click="McpFilter_Click"
                                      ToolTipService.ToolTip="Show only servers that failed to connect"/>
                    </StackPanel>

                    <!-- Footer status bar: server count / connection status / filter matches. -->
                    <TextBlock Grid.Row="4" x:Name="McpPageStatus" Text="" Opacity="0.55" FontSize="11"
                               HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                               Margin="0,2,2,0"/>
                </Grid>

                <!-- ============ SKILLS PAGE ============
                     Global (user) skills: folders under ~/.mandocode/skills, one SKILL.md each.
                     App-wide like MCP — one set, shared by every agent — so it lives on the rail. -->
                <Grid x:Name="SkillsPage" Visibility="Collapsed" Padding="24,16,24,24" RowSpacing="12"
                      Grid.ColumnSpan="5" Grid.RowSpan="3">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SkillsPageTransform"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Skills" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource MandoAccentBrush}"/>
                        <Border Grid.Column="1" Background="{StaticResource MandoPanelBrush}"
                                BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="shared by every agent" FontSize="12" Opacity="0.7"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="A skill is a named set of instructions the AI loads on demand: when your request matches a skill's description, it pulls in the full steps and follows them. These are your global skills — available to every agent. Changes apply immediately."
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                        <AutoSuggestBox x:Name="SkillSearchBox" QueryIcon="Find" Margin="0,4,0,0"
                                        PlaceholderText="Search skills by name or description…"
                                        TextChanged="SkillSearch_TextChanged"
                                        ToolTipService.ToolTip="Filter the list below by name or description"/>
                    </StackPanel>

                    <ListView Grid.Row="3" x:Name="SkillsList" SelectionMode="Single"
                              SelectionChanged="SkillsList_SelectionChanged" DoubleTapped="SkillsList_DoubleTapped"
                              Background="{StaticResource MandoPanelBrush}"
                              BorderBrush="{StaticResource MandoBorderBrush}" BorderThickness="1"
                              CornerRadius="8">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="12"
                                                   Opacity="0.6" Margin="4,10,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SkillRow">
                                <Grid Padding="4,8" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Tag carries the folder path so the Toggled handler knows which
                                         skill to flip without depending on list selection. -->
                                    <ToggleSwitch IsOn="{x:Bind Enabled}" Tag="{x:Bind FolderPath}"
                                                  Toggled="SkillEnabled_Toggled" OnContent="" OffContent=""
                                                  MinWidth="0" VerticalAlignment="Center"
                                                  ToolTipService.ToolTip="Enable or disable this skill for every agent"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold"
                                               FontFamily="Cascadia Code,Consolas" FontSize="13"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Description}" Opacity="0.7"
                                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <!-- Approx size of the instructions body — the load-time prompt cost.
                                         Gold when large, so heavy skills stand out at a glance. -->
                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeLabel}" Foreground="{x:Bind SizeBrush}"
                                               FontSize="11" VerticalAlignment="Center" TextAlignment="Right"
                                               ToolTipService.ToolTip="Approximate tokens added to the prompt when this skill loads. Larger = heavier for the model."/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SkillNewButton" Click="SkillNew_Click" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="New Skill"
                                ToolTipService.ToolTip="Write a new global skill">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="New Skill"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SkillEditButton" Click="SkillEdit_Click" IsEnabled="False"
                                AutomationProperties.Name="Edit Skill"
                                ToolTipService.ToolTip="Edit the selected skill (or double-click a row)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                <TextBlock Text="Edit"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SkillDeleteButton" Click="SkillDelete_Click" IsEnabled="False"
                                AutomationProperties.Name="Delete Skill"
                                ToolTipService.ToolTip="Delete the selected skill's folder">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                <TextBlock Text="Delete"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SkillInstallButton" Click="SkillInstall_Click"
                                AutomationProperties.Name="Install Skill"
                                ToolTipService.ToolTip="Install skills from a git URL, a .zip, or a local folder">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="13"/>
                                <TextBlock Text="Install from…"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SkillOpenFolderButton" Click="SkillOpenFolder_Click"
                                AutomationProperties.Name="Open skills folder"
                                ToolTipService.ToolTip="Open the global skills folder in File Explorer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE838;" FontSize="13"/>
                                <TextBlock Text="Open folder"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SkillRefreshButton" Click="SkillRefresh_Click"
                                AutomationProperties.Name="Refresh skills"
                                ToolTipService.ToolTip="Re-scan the skills folder">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        </Button>
                        <!-- Divider between the action group and the filter group. -->
                        <Border Width="1" Margin="0,4" VerticalAlignment="Stretch"
                                Background="{StaticResource MandoBorderBrush}" Opacity="0.6"/>
                        <ToggleButton x:Name="SkillFilterAll" Content="All" IsChecked="True" Tag="all" Click="SkillFilter_Click"
                                      ToolTipService.ToolTip="Show every skill"/>
                        <ToggleButton x:Name="SkillFilterEnabled" Content="Enabled" Tag="enabled" Click="SkillFilter_Click"
                                      ToolTipService.ToolTip="Show only enabled skills (the ones every agent can load)"/>
                        <ToggleButton x:Name="SkillFilterDisabled" Content="Disabled" Tag="disabled" Click="SkillFilter_Click"
                                      ToolTipService.ToolTip="Show only disabled skills (turned off, not in any prompt)"/>
                        <ToggleButton x:Name="SkillFilterLarge" Content="Large" Tag="large" Click="SkillFilter_Click"
                                      ToolTipService.ToolTip="Show only large skills — a big instructions body is heavier every time it loads"/>
                    </StackPanel>

                    <!-- Footer status bar: skill count + folder path (and filter matches). Quiet and
                         right-aligned below the list, out of the header's way. -->
                    <TextBlock Grid.Row="4" x:Name="SkillsPageStatus" Text="" Opacity="0.55" FontSize="11"
                               HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                               Margin="0,2,2,0"/>
                </Grid>
        </Grid>
        </Grid>

        <!-- ======= Approval toast — top-right, shown only when an approval arrives in an agent
             you're not looking at. Click = select that agent and review; X = dismiss (the tab's
             gold badge stays as the passive reminder). ======= -->
        <!-- Span ALL three columns (rail + snapshots + content) so it anchors to the window's true
             top-right. Spanning only 0-1 pinned it to the collapsible Snapshots column, so it was
             clipped to the rail unless that panel happened to be open. -->
        <Border x:Name="ApprovalToast" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,20,0"
                MaxWidth="380" Padding="14,12"
                Background="{StaticResource MandoPanelBrush}"
                BorderBrush="{StaticResource MandoGoldBrush}" BorderThickness="1"
                CornerRadius="10" Tapped="ApprovalToast_Tapped">
            <Border.Transitions>
                <TransitionCollection>
                    <EdgeUIThemeTransition Edge="Right"/>
                </TransitionCollection>
            </Border.Transitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Center"
                          Foreground="{StaticResource MandoGoldBrush}"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Approval required" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="ApprovalToastText" Text="" FontSize="12" Opacity="0.75"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ApprovalToastTarget" Text="" FontSize="11"
                               Foreground="{StaticResource MandoSkyBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Click="ApprovalToastDismiss_Click" Padding="6"
                        Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                        ToolTipService.ToolTip="Dismiss">
                    <FontIcon Glyph="&#xE711;" FontSize="11"/>
                </Button>
            </Grid>
        </Border>

        <!-- ======= MCP server editor modal ======= -->
        <Grid x:Name="McpEditorOverlay" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="#B0000000">
            <Border Width="560" MaxHeight="700" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource MandoPanelBrush}"
                    BorderBrush="{StaticResource MandoAccentBrush}" BorderThickness="1"
                    CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="McpEditorTitle" Text="Add MCP server" FontSize="18"
                                   FontWeight="SemiBold" Foreground="{StaticResource MandoAccentBrush}"/>

                        <TextBlock Text="Name" FontSize="13" Opacity="0.8"/>
                        <TextBox x:Name="M_Name" PlaceholderText="short identifier, no spaces (e.g. solana)"/>

                        <TextBlock Text="Transport" FontSize="13" Opacity="0.8"/>
                        <ComboBox x:Name="M_Transport" HorizontalAlignment="Stretch"
                                  SelectionChanged="M_Transport_SelectionChanged">
                            <x:String>stdio (local process)</x:String>
                            <x:String>http (remote server)</x:String>
                        </ComboBox>

                        <StackPanel x:Name="M_StdioPanel" Spacing="12">
                            <TextBlock Text="Command" FontSize="13" Opacity="0.8"/>
                            <TextBox x:Name="M_Command" PlaceholderText="npx, uvx, or a binary path"/>
                            <TextBlock Text="Arguments (space-separated; quote paths with spaces)" FontSize="13" Opacity="0.8"/>
                            <TextBox x:Name="M_Args" PlaceholderText="-y @scope/server-foo"
                                     FontFamily="Cascadia Code,Consolas"/>
                            <TextBlock Text="Environment variables (one KEY=value per line)" FontSize="13" Opacity="0.8"/>
                            <TextBox x:Name="M_Env" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120"
                                     PlaceholderText="API_KEY=abc123" FontFamily="Cascadia Code,Consolas"/>
                        </StackPanel>

                        <StackPanel x:Name="M_HttpPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="URL" FontSize="13" Opacity="0.8"/>
                            <TextBox x:Name="M_Url" PlaceholderText="https://mcp.example.com/mcp"/>
                            <TextBlock Text="Headers (one KEY=value per line, e.g. Authorization)" FontSize="13" Opacity="0.8"/>
                            <TextBox x:Name="M_Headers" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="120"
                                     PlaceholderText="Authorization=Bearer …" FontFamily="Cascadia Code,Consolas"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="M_Disabled" Header="Disabled (keep configured, don't connect)"/>

                        <!-- One status surface for the whole modal: validation errors (red),
                             test-in-progress (blue + spinner), test results (green + tool chips). -->
                        <InfoBar x:Name="M_StatusBar" IsOpen="False" IsClosable="True">
                            <InfoBar.Content>
                                <StackPanel Spacing="8" Margin="0,0,0,10">
                                    <ProgressRing x:Name="M_TestSpin" IsActive="False" Width="16" Height="16"
                                                  Visibility="Collapsed" HorizontalAlignment="Left"/>
                                    <!-- Read-only data grid: header row + fixed-column ListView
                                         (WinUI 3 has no built-in DataGrid; this is the native pattern). -->
                                    <Border x:Name="M_TestToolsTable" Visibility="Collapsed"
                                            BorderBrush="{StaticResource MandoBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,2,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Padding="16,8,12,8" ColumnSpacing="14"
                                                  Background="{ThemeResource LayerFillColorAltBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tool" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                                                <TextBlock Grid.Column="1" Text="Description" FontWeight="SemiBold"
                                                           FontSize="12" Opacity="0.8"/>
                                            </Grid>
                                            <ListView Grid.Row="1" x:Name="M_TestTools" SelectionMode="None"
                                                      MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="local:ToolChip">
                                                        <Grid Padding="0,6" ColumnSpacing="14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="210"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Name}" FontSize="12"
                                                                       FontFamily="Cascadia Code,Consolas"
                                                                       Foreground="{StaticResource MandoSkyBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Description}"
                                                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </InfoBar.Content>
                        </InfoBar>

                        <Grid>
                            <Button x:Name="McpEditorTestButton" Click="McpEditorTest_Click"
                                    HorizontalAlignment="Left"
                                    ToolTipService.ToolTip="Try connecting with these values — nothing is saved, running servers aren't touched">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                    <TextBlock Text="Test"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Cancel" Click="McpEditorCancel_Click"/>
                                <Button x:Name="McpEditorSaveButton" Content="Save &amp; Connect"
                                        Click="McpEditorSave_Click" Style="{StaticResource AccentButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ======= Skill editor modal =======
             Stretches with the window (capped) rather than a fixed box, so the instructions editor
             gets real room. Two panes: metadata + AI drafting on the left, the body on the right. -->
        <Grid x:Name="SkillEditorOverlay" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="#B0000000">
            <Border Margin="72,40" MaxWidth="1200" MaxHeight="900" Padding="24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{StaticResource MandoPanelBrush}"
                    BorderBrush="{StaticResource MandoAccentBrush}" BorderThickness="1"
                    CornerRadius="12">
                <Grid RowSpacing="14" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" x:Name="SkillEditorTitle" Text="New skill" FontSize="18"
                               FontWeight="SemiBold" Foreground="{StaticResource MandoAccentBrush}"/>

                    <!-- Left pane: Draft with AI, given the whole column so the intent box is large -->
                    <Grid Grid.Row="1" Grid.Column="0" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="15" Foreground="{StaticResource MandoGoldBrush}"/>
                            <TextBlock Text="Draft with AI" FontWeight="SemiBold" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox Grid.Row="1" x:Name="Sk_AiModel" HorizontalAlignment="Stretch" Header="Model"
                                  ToolTipService.ToolTip="Defaults to the active agent's model — change it per draft">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:ModelChoice">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Tag}" Opacity="0.55" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox Grid.Row="2" x:Name="Sk_AiIntent" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Header="What should this skill do?"
                                 PlaceholderText="e.g. review a SQL query against the database schema and flag bad column names, then suggest fixes — describe the workflow you want the AI to follow"/>

                        <StackPanel Grid.Row="3" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="Sk_GenerateButton" Click="SkillGenerate_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Draft name, description, and instructions from your intent">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE945;" FontSize="13"/>
                                        <TextBlock Text="Generate"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="Sk_RefineButton" Click="SkillRefine_Click"
                                        ToolTipService.ToolTip="Rewrite the current instructions using your intent as the change to make">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                        <TextBlock Text="Refine"/>
                                    </StackPanel>
                                </Button>
                                <ProgressRing x:Name="Sk_AiSpin" IsActive="False" Width="18" Height="18"
                                              Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="Sk_AiStatus" Text="" FontSize="12" Opacity="0.75"
                                       TextWrapping="Wrap" Foreground="{StaticResource MandoGoldBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Right pane: the editable fields — Name, Description, Instructions body -->
                    <Grid Grid.Row="1" Grid.Column="1" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Name" FontSize="13" Opacity="0.8"/>
                            <TextBox x:Name="Sk_Name" PlaceholderText="short name (e.g. commit-message)"/>

                            <TextBlock Text="Description — one line; the AI matches this against your request to decide when to load the skill"
                                       FontSize="13" Opacity="0.8" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBox x:Name="Sk_Description" TextWrapping="Wrap" AcceptsReturn="False"
                                     PlaceholderText="Write a Conventional Commits message from staged changes"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Instructions (markdown) — the steps the AI follows once this skill loads"
                                           FontSize="13" Opacity="0.8" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" x:Name="Sk_BodySize" Text="" FontSize="11"
                                           VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <TextBox Grid.Row="1" x:Name="Sk_Body" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Top" TextChanged="Sk_Body_TextChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Code,Consolas" FontSize="13"
                                 PlaceholderText="## Steps&#x0a;1. Inspect the staged diff&#x0a;2. …"/>
                    </Grid>

                    <!-- Footer spanning both panes -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <InfoBar x:Name="Sk_StatusBar" IsOpen="False" IsClosable="True" Severity="Error"
                                 VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Click="SkillEditorCancel_Click"/>
                            <Button x:Name="SkillEditorSaveButton" Content="Save" Click="SkillEditorSave_Click"
                                    Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ======= Skill install modal ======= -->
        <Grid x:Name="SkillInstallOverlay" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="#B0000000">
            <Border Width="600" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource MandoPanelBrush}"
                    BorderBrush="{StaticResource MandoAccentBrush}" BorderThickness="1"
                    CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock Text="Install skills" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource MandoAccentBrush}"/>
                    <TextBlock Text="A source can hold one skill (a SKILL.md at its root) or many (subfolders, each with a SKILL.md). Anything already installed is skipped."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>

                    <RadioButtons x:Name="Sk_InstallMode" MaxColumns="2"
                                  SelectionChanged="SkillInstallMode_Changed">
                        <x:String>From Git</x:String>
                        <x:String>From folder / .zip</x:String>
                    </RadioButtons>

                    <!-- Git: paste is the right interaction, so no Browse here. Needs Git installed. -->
                    <StackPanel x:Name="Sk_InstallGitPanel" Spacing="6">
                        <TextBox x:Name="Sk_InstallGitUrl"
                                 Header="Repository URL"
                                 PlaceholderText="https://github.com/user/my-skills.git"
                                 FontFamily="Cascadia Code,Consolas"/>
                        <TextBlock Text="Clones with git — Git must be installed and on PATH."
                                   Opacity="0.5" FontSize="11"/>
                    </StackPanel>

                    <!-- Local: Browse so you don't have to type an exact path. -->
                    <StackPanel x:Name="Sk_InstallLocalPanel" Spacing="6" Visibility="Collapsed">
                        <TextBox x:Name="Sk_InstallLocalPath"
                                 Header="Folder or .zip path"
                                 PlaceholderText="C:\path\to\skill  (or a .zip)"
                                 FontFamily="Cascadia Code,Consolas"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="SkillBrowseFolder_Click"
                                    ToolTipService.ToolTip="Pick a folder containing a SKILL.md (or subfolders that do)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                    <TextBlock Text="Browse folder…"/>
                                </StackPanel>
                            </Button>
                            <Button Click="SkillBrowseZip_Click"
                                    ToolTipService.ToolTip="Pick a .zip archive of skills">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                    <TextBlock Text="Browse .zip…"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="Sk_InstallSpin" IsActive="False" Width="16" Height="16"
                                      Visibility="Collapsed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Sk_InstallStatus" Text="" FontSize="12" Opacity="0.8"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <InfoBar x:Name="Sk_InstallError" IsOpen="False" IsClosable="True" Severity="Error"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="SkillInstallCancel_Click"/>
                        <Button x:Name="SkillInstallConfirmButton" Content="Install" Click="SkillInstallConfirm_Click"
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
