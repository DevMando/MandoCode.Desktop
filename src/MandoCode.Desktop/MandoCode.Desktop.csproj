<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MandoCode.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Prerelease tag for the MAF workflow-planner branch, so the window title makes it obvious
         which binary is running while both planner engines are selectable. UiUpdateCheckService
         compares the numeric CurrentVersion, so update checks are unaffected.
         Drop the suffix before release. -->
    <Version>0.15.0-plan-test</Version>
    <Authors>Armando Fernandez (DevMando)</Authors>
    <Description>MandoCode Desktop — the MandoCode AI coding agent with a native WinUI 3 interface.</Description>
    <!-- Embedded in the exe → taskbar, Alt-Tab, and Explorer icon. The title-bar icon is set at
         runtime from the same .ico (MainWindow), which is also copied to the output below. -->
    <ApplicationIcon>Assets\images\mandocode-desktop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local web assets served to the transcript WebView2 via
         SetVirtualHostNameToFolderMapping. Bundled, never fetched from a CDN,
         so the transcript works fully offline (MandoCode is offline-first). -->
    <Content Include="Assets\web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The app icon, copied alongside the exe so MainWindow can set the title-bar icon at runtime. -->
    <Content Include="Assets\images\mandocode-desktop.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Chat backgrounds offered in Settings → Appearance. Discovered at runtime by
         BuiltInBackgrounds, so adding one to a future release is a file drop here — no code change.
         Listed explicitly (by extension) rather than left to the implicit Assets\** glob in
         Microsoft.WinUI.props: the images shipping is the whole feature, so it shouldn't depend on
         an SDK package's internal item list. -->
    <Content Include="Assets\images\backgrounds\*.jpg;Assets\images\backgrounds\*.jpeg;Assets\images\backgrounds\*.png;Assets\images\backgrounds\*.webp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- That same WinUI glob sweeps in the folder's README, which an unpackaged build then copies
         beside the exe. It's guidance for whoever adds the next image, not a shipped asset — so drop
         it from Content, and keep it as None so it stays visible in the IDE. Must come AFTER the
         include above: a Remove only affects items already in the list. -->
    <Content Remove="Assets\images\backgrounds\README.md" />
    <None Include="Assets\images\backgrounds\README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <!-- Declared here on purpose, even though the harness already brings both in: the Desktop
         services below (NoteAssistant, SnapshotEnhancer, SkillAuthor) call Ollama directly and
         name these types themselves. Relying on the harness's transitive copies is what broke
         this project when the harness dropped Semantic Kernel — a dependency we compiled against
         but never declared. Keep the versions in step with MandoCode/src/MandoCode.csproj.
         OllamaSharp's analyzers are excluded for the same reason they are in the harness: its
         source generator targets a newer Roslyn than current VS/SDK builds ship (CS9057), and it
         only generates code for [OllamaTool] types, which nothing here uses. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" ExcludeAssets="analyzers" />
  </ItemGroup>

  <ItemGroup>
    <!-- The entire MandoCode harness — AI service, planner, plugins, MCP, skills,
         config, approvals, token tracking — reused verbatim from the CLI project,
         pulled in as a git submodule pinned at the repo root (/MandoCode).
         Only the user interface is replaced (WinUI 3 instead of RazorConsole).
         Clone recursively, or run "git submodule update" with the init flag. -->
    <ProjectReference Include="..\..\MandoCode\src\MandoCode\MandoCode.csproj" />
  </ItemGroup>

  <!-- Every agent tab runs on its own clone of MandoCodeConfig so it can pin its own model.
       A clone must never be persisted: MandoCodeConfig.Save() always writes the one shared
       ~/.mandocode/config.json, so a stray _config.Save() in ChatController would silently
       publish one tab's model as everybody's default.

       ConfigCoordinator is the only place allowed to call Save(). That can't be enforced by
       the type system — Save() is public and non-virtual on a type in the read-only harness
       submodule — so it's enforced here instead, and it breaks the build rather than a test. -->
  <Target Name="GuardAgainstDirectConfigSave" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ChatControllerSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\ViewModels\ChatController.cs'))</_ChatControllerSource>
      <_WizardsSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\ViewModels\ChatController.Wizards.cs'))</_WizardsSource>
    </PropertyGroup>
    <Error Condition="$(_ChatControllerSource.Contains('_config.Save')) Or $(_WizardsSource.Contains('_config.Save'))"
           Code="MANDO001"
           Text="ChatController must not call _config.Save() — it holds a per-tab config clone, and Save() writes the shared config file. Mutate ConfigCoordinator.Defaults and call SaveDefaults() (or SaveDefaultsFrom(agentConfig)) instead." />
  </Target>

</Project>
